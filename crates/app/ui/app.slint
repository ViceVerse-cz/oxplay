                if !root.guide-compact: Action { icon-name: "trophy"; label: "Sports"; accessible-label: "Search YouTube for sports"; dense: true; corner-radius: 10px; height: 36px; enabled: !root.busy && !root.account-busy && !root.native-video-child; clicked => { search.text = "Sports"; root.search(search.text); } }
                if !root.guide-compact: Action { icon-name: "graduation-cap"; label: "Learning"; accessible-label: "Search YouTube for learning"; dense: true; corner-radius: 10px; height: 36px; enabled: !root.busy && !root.account-busy && !root.native-video-child; clicked => { search.text = "Learning"; root.search(search.text); } }
