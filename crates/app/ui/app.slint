                Action { label: "Science"; accessible-label: "Search YouTube for science"; variant: ActionVariant.secondary; height: 36px; width: 96px; horizontal-stretch: 0; enabled: !root.busy && !root.account-busy && !root.native-video-child; clicked => { search.text = "Science"; root.search(search.text); } }
                Action { label: "Gaming"; accessible-label: "Search YouTube for gaming"; variant: ActionVariant.secondary; height: 36px; width: 96px; horizontal-stretch: 0; enabled: !root.busy && !root.account-busy && !root.native-video-child; clicked => { search.text = "Gaming"; root.search(search.text); } }
