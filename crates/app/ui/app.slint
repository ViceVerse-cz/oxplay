    public function show-video-details() {
        if root.remote-video && root.loaded && !root.video-only {
            CommentsUi.description-expanded = true;
            watch.content-y = max(min(0px, watch.visible-height - watch.content-height), -watch-details.y);
            watch-details.focus-description();
