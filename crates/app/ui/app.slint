        visible: !root.video-only;
        width: parent.width; height: root.top-height; background: Colors.canvas;
        Action { x: 16px; y: 8px; width: 40px; compact: true; icon-name: "menu"; label: "Toggle sidebar"; clicked => { root.expanded-sidebar = !root.expanded-sidebar; } }
        Rectangle { x: 72px; y: 13px; width: 30px; height: 30px; border-radius: 9px; background: Colors.accent;
            Image { x: 5px; y: 5px; width: 20px; height: 20px; source: @image-url("icons/clapperboard.svg"); colorize: Colors.canvas; }
        }
        Text { x: 110px; y: 0; height: parent.height; width: 100px; text: "serein"; color: Colors.text; font-size: 25px; font-weight: 700; vertical-alignment: center; }
        Rectangle {
            x: max(228px, (root.width - self.width) / 2); y: 7px;
            width: min(620px, root.width - 418px); height: 42px;
