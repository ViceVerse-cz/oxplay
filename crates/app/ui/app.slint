// Guide section chrome: a hairline divider and a compact section title.
component GuideDivider inherits Rectangle {
    height: 17px;
    Rectangle { x: 2px; y: 8px; width: parent.width - 4px; height: 1px; background: Colors.border; }
}
component GuideHeading inherits Rectangle {
    in property <string> text;
    height: 36px;
    Text { x: 14px; width: parent.width - 14px; height: parent.height; text: root.text; color: Colors.text; font-size: 16px; font-weight: 700; vertical-alignment: center; }
}
export component App inherits Window {
