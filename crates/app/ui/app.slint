            if root.guest-scope == 1: ConfirmedChoice { accessible-label: "Channel content type"; width: 170px; horizontal-stretch: 0; model: ["Videos", "Shorts", "Streams", "Playlists"]; acknowledged-index: root.channel-tab; enabled: !root.native-video-child && !root.busy; choose(index) => { root.channel-tab-changed(index); } }
            if root.guest-can-follow: Action { height: 36px; variant: ActionVariant.primary; icon-name: "plus"; label: "Follow locally"; width: 148px; horizontal-stretch: 0; enabled: !root.native-video-child && !root.busy && !LibraryUi.busy; clicked => { root.follow-guest-channel(); } }
            if root.guest-scope == 2: Text { text: "Public YouTube playlist"; color: Colors.muted; vertical-alignment: center; }
