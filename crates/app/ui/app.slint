                text: root.picture-in-picture && root.diagnostic-fixture-label != "" ? "TEST FIXTURE · Picture in picture" : root.picture-in-picture && root.diagnostic-warning != "" ? root.diagnostic-warning : root.can-retry-playback ? "Playback failed · Retry starts from the beginning" : (root.picture-in-picture && root.playback-status == "" ? "Picture in picture · P or Esc to return" : root.playback-status); color: Colors.muted;
                font-size: 12px; overflow: elide;
                accessible-label: "Playback status: " + self.text;
            }
        }
        related-parking := FocusScope {
            x: related.x; y: related.y; width: related.width; height: related.height;
            // Keep enabled to receive FocusOut: pinned Slint ignores even
            // FocusOut on a disabled scope, leaving has-focus stale. Rust
            // guards every request by active surface; this is never a Tab/click stop.
            focus-on-tab-navigation: false; focus-on-click: false;
            focus-lost => { root.feed-parking-lost(); }
            key-pressed(event) => {
                let command = CatalogKeys.command(event);
                let index = root.feed-focus-surface == 1 && root.feed-focus-target >= 0 ? root.feed-focus-target : min(root.videos.length - 1, max(0, floor((-related.content-y + root.related-clip-top) / 106px)));
