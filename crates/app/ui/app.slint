            }
            if root.groups.length > 0 && (root.has-more || root.has-previous): HorizontalLayout {
                y: root.feed-inset + root.groups.length * root.row-height + 4px; height: 36px; spacing: 8px; alignment: center;
                Action { icon-name: "chevron-left"; label: "Previous page"; variant: ActionVariant.secondary; height: 36px; width: 150px; horizontal-stretch: 0; enabled: !root.native-video-child && !root.busy && !root.home-loading && root.has-previous; clicked => { root.guest-previous(); } }
                Action { icon-name: "chevron-right"; label: root.busy ? "Loading…" : "Next page"; variant: ActionVariant.secondary; height: 36px; width: 150px; horizontal-stretch: 0; enabled: !root.native-video-child && !root.busy && !root.home-loading && root.has-more; clicked => { root.more(); } }
            }
        }
