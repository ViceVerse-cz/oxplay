            // Retire parking before the related surface disappears.
            // Transfer only retiring related focus, without resetting the saved
            // outer watch offset or stealing focus from search/player controls.
            if root.watching && (related-parking.has-focus || root.feed-focused-index >= 0) { focus.focus(); }
            root.feed-focus-cancel();
        }
        root.restore-watch-scroll();
        root.refresh-visible();
    }
    changed theme => {
        Colors.dark = root.theme == 0 ? root.system-dark : root.theme == 2;
        Palette.color-scheme = Colors.dark ? ColorScheme.dark : ColorScheme.light;
    }
    changed system-dark => {
        Colors.dark = root.theme == 0 ? root.system-dark : root.theme == 2;
        Palette.color-scheme = Colors.dark ? ColorScheme.dark : ColorScheme.light;
    }
    public function refresh-visible() {
        if root.page == 0 {
            root.visible-range(root.first-row * root.columns, root.last-row * root.columns, root.feed-thumbnail-first, root.feed-thumbnail-end);
        } else if root.page == 2 && !root.video-only {
            root.visible-range(root.related-first, root.related-last, -1, -1);
        } else if root.page == 1 && LibraryUi.tab == 2 {
            LibraryUi.visible-range(LibraryUi.viewport-offset, LibraryUi.viewport-height, LibraryUi.viewport-narrow);
        } else { root.visible-range(0, 0, -1, -1); }
    }
    public function focus-player() { root.prepare-native-overlay(); root.saved-watch-offset = 0px; watch.content-y = 0px; focus.focus(); }
    function restore-watch-scroll() {
        watch.content-y = root.compact-video ? 0px : max(min(root.saved-watch-offset, 0px), min(0px, watch.visible-height - watch.content-height));
    }
    public function focus-search() { if !root.native-video-child { search.focus(); } }
    public function focus-browse() { shortcuts.focus(); }
    public function park-feed-focus(surface: int) {
        if surface == 0 { feed-parking.focus(); }
        else if surface == 1 { related-parking.focus(); }
    }
    public function reveal-feed-item(index: int) {
        // Rows start after feed-inset; revealing keeps that margin above a card.
        let top = floor(index / root.columns) * root.row-height;
        if top + feed.content-y < 0px { feed.content-y = -top; }
        if root.feed-inset + top + root.row-height + feed.content-y > feed.visible-height {
            feed.content-y = min(0px, feed.visible-height - root.feed-inset - top - root.row-height);
        }
        root.refresh-visible();
    }
    public function reveal-related-item(index: int) {
        // At compact widths the list is below the player. Reveal its outer
        // viewport first, then the requested row inside the same ListView.
        if related.y + watch.content-y < 0px { watch.content-y = -related.y; }
        if related.y + related.height + watch.content-y > watch.visible-height {
            watch.content-y = min(0px, watch.visible-height - related.y - related.height);
        }
        watch.content-y = max(min(0px, watch.content-y), min(0px, watch.visible-height - watch.content-height));
        root.saved-watch-offset = watch.content-y;
        let top = index * 106px;
        if top + related.content-y < root.related-clip-top { related.content-y = root.related-clip-top - top; }
        if top + 106px + related.content-y > root.related-clip-bottom {
            related.content-y = min(0px, root.related-clip-bottom - top - 106px);
        }
        root.refresh-visible();
    }
    // While the glow shows, this one canvas spans the header and guide too and
    // their own backgrounds turn transparent (chrome-background), so the glow
    // can reach under them without stacking two translucent tints.
    Rectangle {
        x: root.ambient-shown ? 0px : root.sidebar-width; y: root.ambient-shown ? 0px : root.top-height;
        width: root.width - self.x; height: root.height - self.y;
        background: Colors.canvas;
    }
    // Ambient glow: directly above the canvas and below every other element,
    // including the header and guide. The image's central 64×36 texels (plus
    // ambient-margin texels all around) sit exactly behind the video host
    // (see ambient_ui.rs); bilinear
    // upscaling of the pre-blurred image keeps it soft. A leaf Image with
    // opacity uses global alpha, not an offscreen layer.
    Image {
        visible: root.ambient-shown;
        x: root.video-window-x - root.video-width * root.ambient-margin / 64;
        y: root.video-window-y - root.video-height * root.ambient-margin / 36;
        width: root.video-width * (64 + 2 * root.ambient-margin) / 64; height: root.video-height * (36 + 2 * root.ambient-margin) / 36;
        source: root.ambient-image;
        image-fit: fill; image-rendering: smooth;
        opacity: root.ambient-ready ? 1 : 0;
        animate opacity { duration: 600ms; easing: ease-in-out; }
    }
    osd-timer := Timer {
        interval: 900ms; running: false;
        triggered => { root.osd-text = ""; self.running = false; }
    }
    flash-timer := Timer {
        interval: 500ms; running: false;
        triggered => { root.flash-on = false; self.running = false; }
    }
    shortcuts := FocusScope {
    x: 0; y: 0; width: root.width; height: root.height;
    // Neutral startup focus belongs to the stable shared shell. Search keeps
    // its normal caret when explicitly reached by slash, Tab, click or focus().
    // This ancestor is not an extra stop in the interactive Tab order.
    focus-on-tab-navigation: false;
    focus-on-click: false;
    capture-key-pressed(event) => {
        if root.video-visible { root.controls-activity(); }
        // Arrow/Escape navigation of the open search suggestions, before the editor.
        if search.has-focus && !event.modifiers.control && !event.modifiers.alt && !event.modifiers.meta && suggestions.key(event.text) { return accept; }
        return reject;
    }
    key-pressed(event) => {
        // Child widgets receive keys first, but TextInput rejects some special
        // keys (including Escape). Do not turn their bubbling events into media
        // commands while any editor/IME owns focus. Popup default handling stays
        // in Slint because rejected events continue through its normal path.
        // Watch tabs: Ctrl+Tab / Ctrl+Shift+Tab cycle, Cmd/Ctrl+W closes. These
        // chords are unused by editors, so they also work while typing.
        if (event.modifiers.control || event.modifiers.meta) && !event.modifiers.alt && (event.text == Key.Tab || event.text == Key.Backtab) {
            if TabsUi.tabs.length == 0 || root.video-only { return reject; }
            TabsUi.cycle(!event.modifiers.shift && event.text != Key.Backtab); return accept;
        }
        if (event.modifiers.control || event.modifiers.meta) && !event.modifiers.alt && !event.modifiers.shift && event.text == "w" {
            if TabsUi.active-index < 0 || root.video-only { return reject; }
            TabsUi.close-active(); return accept;
        }
        if TextInputInterface.text-input-focused { return reject; }
        if (event.modifiers.control || event.modifiers.meta) && !event.modifiers.alt && event.text == "o" {
            if !root.native-video-child && !root.local-file-busy { root.open-video-file(); }
            return accept;
        }
        if event.modifiers.control || event.modifiers.alt || event.modifiers.meta { return reject; }
        if event.text == "/" { if !root.picture-in-picture && !root.native-video-child { search.focus(); } return accept; }
        if event.text == "?" { root.prepare-native-overlay(); shortcuts-popup.show(); return accept; }
        if root.watching || (root.mini-player-active && focus.has-focus) {
            if event.text == " " || event.text == "k" { root.user-toggle-pause(); return accept; }
            if event.text == "g" { root.show-jump(); return accept; }
            if event.text == "j" { root.relative-seek(-10); root.show-osd("− 10 s"); return accept; }
            if event.text == "l" { root.relative-seek(10); root.show-osd("+ 10 s"); return accept; }
            if event.text == Key.LeftArrow { root.relative-seek(-5); root.show-osd("− 5 s"); return accept; }
            if event.text == Key.RightArrow { root.relative-seek(5); root.show-osd("+ 5 s"); return accept; }
            if event.text == Key.UpArrow { root.volume(min(100, root.volume-level + 5)); root.show-osd("Volume " + round(min(100, root.volume-level + 5)) + "%"); return accept; }
            if event.text == Key.DownArrow { root.volume(max(0, root.volume-level - 5)); root.show-osd("Volume " + round(max(0, root.volume-level - 5)) + "%"); return accept; }
            if event.text == "m" { if root.mute-known { root.show-osd(root.muted ? "Sound on" : "Muted"); } root.mute(); return accept; }
            // YouTube keys: 0–9 jump to 0–90 %, Shift+. / Shift+, change speed.
            if event.text.is-float() && root.loaded && root.duration > 0 {
                let tenth = event.text.to-float();
                if tenth >= 0 && tenth <= 9 && floor(tenth) == tenth {
                    root.seek(root.duration * tenth / 10);
                    root.show-osd(round(tenth * 10) + "%");
                    return accept;
                }
            }
            if (event.text == ">" || event.text == "<") && root.remote-video && !root.speed-busy {
                let next = clamp(root.speed-index + (event.text == ">" ? 1 : -1), 0, 3);
                root.speed((next + 1) * 0.5);
                root.show-osd(next == 1 ? "Normal speed" : ((next + 1) * 0.5) + "×");
                return accept;
            }
            if event.text == "f" { if root.mini-player-active { root.navigate(2); } root.fullscreen(); return accept; }
            if event.text == "t" { root.toggle-theatre(); return accept; }
            if event.text == "p" { root.picture-in-picture-toggle(); return accept; }
            if event.text == Key.Escape { if root.theatre-active { root.toggle-theatre(); } else { root.exit-fullscreen(); } return accept; }
        }
        return reject;
    }
    shortcuts-popup := PopupWindow {
        close-policy: close-on-click-outside;
        x: (root.width - self.width) / 2; y: (root.height - self.height) / 2;
        width: min(560px, root.width - 48px); height: min(470px, root.height - 48px);
        forward-focus: shortcuts-close;
        Rectangle {
            background: Colors.dialog; border-radius: 16px; border-width: 1px; border-color: Colors.border;
            VerticalLayout { padding: 20px; spacing: 14px;
                HorizontalLayout { height: 36px;
                    Text { text: "Keyboard shortcuts"; color: Colors.text; font-size: 20px; font-weight: 700; vertical-alignment: center; horizontal-stretch: 1; }
                    shortcuts-close := Action { width: 36px; height: 36px; horizontal-stretch: 0; compact: true; icon-name: "x"; label: "Close keyboard shortcuts"; clicked => { shortcuts-popup.close(); } }
                }
                HorizontalLayout { spacing: 24px;
                    for column in [
                        [["Space / K", "Play or pause"], ["J / L", "Back or forward 10 s"], ["← / →", "Back or forward 5 s"], ["0 – 9", "Jump to 0–90 %"], ["G", "Jump to a time"], ["Shift + < / >", "Slower or faster"], ["Ctrl + Tab", "Next tab (Shift: previous)"], ["Ctrl/Cmd + W", "Close tab"]],
                        [["↑ / ↓", "Volume"], ["M", "Mute"], ["F", "Fullscreen"], ["T", "Theatre mode"], ["P", "Picture in picture"], ["/", "Search"], ["?", "This list"]],
                    ]: VerticalLayout { spacing: 10px; horizontal-stretch: 1; alignment: start;
                        for row in column: HorizontalLayout { height: 28px; spacing: 12px;
                            Rectangle { width: 108px; horizontal-stretch: 0;
                                Rectangle { x: 0px; width: min(parent.width, key-text.preferred-width + 16px); height: 26px; y: 1px; border-radius: 6px; background: Colors.hover;
                                    key-text := Text { x: 8px; height: parent.height; text: row[0]; color: Colors.text; font-size: 12px; font-weight: 600; vertical-alignment: center; }
                                }
                            }
                            Text { text: row[1]; color: Colors.muted; font-size: 13px; vertical-alignment: center; overflow: elide; }
                        }
                    }
                }
                Text { text: "Playback keys work while the player is showing. They pause while you type."; color: Colors.muted; font-size: 12px; wrap: word-wrap; }
            }
        }
    }
    jump-popup := PopupWindow {
        close-policy: close-on-click-outside;
        forward-focus: jump-dialog;
        x: (root.width - self.width) / 2; y: (root.height - self.height) / 2;
        width: min(390px, root.width - 24px); height: min(255px, root.height - 24px);
        jump-dialog := JumpDialog { width: parent.width; height: parent.height; dismissed => { root.close-jump(); root.focus-video-mode(); } }
    }
    share-popup := PopupWindow {
        close-policy: close-on-click-outside;
        forward-focus: share-address;
        x: (root.width - self.width) / 2; y: (root.height - self.height) / 2;
        width: min(420px, root.width - 24px); height: 340px;
        Rectangle { background: Colors.dialog; border-width: 1px; border-color: Colors.border; border-radius: 16px;
            VerticalLayout { padding: 20px; spacing: 12px;
                Text { text: "Share video"; color: Colors.text; font-size: 20px; font-weight: 600; height: 28px; }
                Text { text: "Copies a public YouTube address. Private videos still require access. Nothing is sent automatically."; color: Colors.muted; wrap: word-wrap; font-size: 12px; height: 44px; }
                share-address := LineEdit { accessible-label: "YouTube video link to share"; read-only: true; text: root.share-link; height: 38px; changed has-focus => { if self.has-focus { self.select-all(); } } }
                HorizontalLayout { spacing: 8px; height: 38px;
                    Action { label: "Copy video link"; variant: ActionVariant.primary; enabled: root.share-available; clicked => { if root.share-copy-request(false) { share-address.select-all(); share-address.copy(); } } }
                    Action { label: "Copy at current time"; variant: ActionVariant.secondary; enabled: root.share-available; clicked => { if root.share-copy-request(true) { share-address.select-all(); share-address.copy(); } } }
                }
                Text { text: root.share-status; accessible-label: root.share-status; color: Colors.muted; wrap: word-wrap; font-size: 12px; height: 42px; }
                Action { label: "Close"; variant: ActionVariant.secondary; height: 34px; clicked => { share-popup.close(); root.focus-video-mode(); } }
            }
        }
    }
    save-popup := PopupWindow {
        close-policy: close-on-click-outside;
            x: (root.width - self.width) / 2; y: (root.height - self.height) / 2;
            width: 400px; height: SaveUi.destinations-paged ? 450px : 410px;
            Rectangle { background: Colors.dialog; border-width: 1px; border-color: Colors.border; border-radius: 16px;
                VerticalLayout { padding: 16px; spacing: 8px;
                    Text { text: "Save to a local playlist"; color: Colors.text; font-size: 18px; font-weight: 600; height: 24px; }
                    Text { text: SaveUi.video-title; color: Colors.text; wrap: word-wrap; overflow: elide; height: 40px; }
                    Text { text: "On this device only. Your YouTube account is unchanged."; color: Colors.muted; wrap: word-wrap; height: 32px; font-size: 12px; }
                    if SaveUi.destinations-paged: Text { text: "Showing the current playlist page. More playlists are available in Local playlists."; color: Colors.muted; wrap: word-wrap; height: 32px; font-size: 12px; }
                    if SaveUi.collections.length > 0: HorizontalLayout { height: 38px; spacing: 8px;
                        ConfirmedChoice {
                            accessible-label: "Local playlist to save into"; model: SaveUi.collections;
                            acknowledged-index: root.save-destination >= 0 && root.save-destination < SaveUi.collections.length ? root.save-destination : -1;
                            enabled: !SaveUi.busy && !SaveUi.saved; horizontal-stretch: 1;
                            choose(index) => { if !SaveUi.busy && !SaveUi.saved && index >= 0 && index < SaveUi.collections.length { root.save-destination = index; } }
                        }
                        Action { label: "Save"; variant: ActionVariant.primary; width: 72px; horizontal-stretch: 0; enabled: !SaveUi.busy && !SaveUi.saved && root.save-destination >= 0 && root.save-destination < SaveUi.collections.length; clicked => { root.save-to-playlist(root.save-destination); } }
                    }
                    if SaveUi.collections.length == 0: Text { text: "Create your first local playlist"; color: Colors.text; height: 30px; }
                    playlist-name := LineEdit { accessible-label: "New local playlist name"; placeholder-text: "New playlist name"; enabled: !SaveUi.busy && !SaveUi.saved; height: 38px; accepted => { if !SaveUi.busy && !SaveUi.saved { SaveUi.create-and-save(self.text); } } }
                    Action { label: "Create and save"; variant: ActionVariant.primary; enabled: !SaveUi.busy && !SaveUi.saved; height: 36px; clicked => { SaveUi.create-and-save(playlist-name.text); } }
                    ScrollView { height: 60px; horizontal-scrollbar-policy: always-off;
                        Text { width: parent.visible-width; text: SaveUi.status; color: Colors.muted; wrap: word-wrap; }
                    }
                    Action { label: SaveUi.saved ? "Done" : "Close"; variant: ActionVariant.secondary; height: 34px; clicked => { save-popup.close(); } }
                }
            }
        }
    playback-settings := PopupWindow {
        close-policy: close-on-click-outside;
        x: clamp(root.video-window-x + root.video-width - self.width - 16px, 8px, max(8px, root.width - self.width - 8px));
        y: clamp(root.video-window-y + root.video-height - self.height - 92px, 8px, max(8px, root.height - self.height - 8px));
        width: 320px; height: min(playback-settings-panel.preferred-height, root.height - 16px);
        forward-focus: playback-settings-panel;
        ScrollView {
            width: parent.width; height: parent.height; horizontal-scrollbar-policy: always-off;
            playback-settings-panel := PlayerSettingsPanel {
                width: parent.visible-width; height: self.preferred-height;
                volume-level: root.volume-level; speed-index: root.speed-index; quality-index: root.quality-index;
                speed-busy: root.speed-busy; quality-busy: root.busy; remote-video: root.remote-video;
                subtitle-available: root.local-subtitle-available && !root.local-file-busy;
                ambient-mode <=> root.ambient-mode;
                glow-size <=> root.glow-size;
                ambient-mode-changed(on) => { root.ambient-mode-changed(on); }
                glow-size-changed(index) => { root.glow-size-changed(index); }
                volume(value) => { root.volume(value); }
                speed(index) => { root.speed((index + 1) * 0.5); }
                quality(index) => { root.quality(index); }
                subtitle => { playback-settings.close(); root.load-subtitle-file(); }
                close => { playback-settings.close(); root.focus-video-mode(); }
            }
        }
    }
    Rectangle {
        x: 0; y: 0px;
        // Cache stable chrome in a GPU layer during video.
        // Focus, hover, edits and theme changes still invalidate this subtree.
        cache-rendering-hint: root.cache-chrome;
        visible: !root.video-only;
        width: parent.width; height: root.header-height; background: root.chrome-background;
        TouchArea {
            width: parent.width; height: parent.height;
            enabled: root.native-header-integrated;
            pointer-event(event) => { if event.kind == PointerEventKind.down && event.button == PointerEventButton.left { root.window-header-drag(); } }
        }
        header-menu := Action { x: root.header-leading-inset + 16px; y: (parent.height - self.height) / 2; width: 36px; height: 36px; compact: true; icon-name: "menu"; label: root.theatre-active ? "Exit theatre mode and show sidebar" : "Toggle sidebar"; clicked => { if root.theatre-active { root.toggle-theatre(); } else { root.expanded-sidebar = !root.expanded-sidebar; } } }
        // Wordmark: a small red play tile beside tightly set lowercase type.
        Rectangle { x: root.header-leading-inset + 64px; y: (parent.height - self.height) / 2; width: 30px; height: 21px; border-radius: 6px; background: Colors.accent;
            Path { x: 11px; y: 6px; width: 9px; height: 9px; fill: #ffffff; viewbox-width: 9; viewbox-height: 9; commands: "M 0 0 L 9 4.5 L 0 9 Z"; }
        }
        Text { x: root.header-leading-inset + 100px; y: 0; height: parent.height; width: 90px; text: "oxplay"; color: Colors.text; font-size: 20px; font-weight: 700; letter-spacing: -0.6px; vertical-alignment: center; }
        search := SearchField {
            x: max(root.header-leading-inset + 220px, (root.width - self.width) / 2); y: (parent.height - self.height) / 2;
            width: min(640px, root.width - 420px - root.header-leading-inset); height: 36px;
            enabled: !root.native-video-child; cache-rendering-hint: root.cache-search;
            placeholder: root.native-video-child ? "Local-only diagnostic" : "Search YouTube";
            edited => { root.cancel-playback-focus(); suggestions.edited(); }
            accepted(text) => { suggestions.close(); root.search(text); }
        }
        header-account := Action { enabled: !root.native-video-child; x: parent.width - self.width - 20px; y: (parent.height - self.height) / 2; width: 144px; height: 32px; variant: ActionVariant.secondary; icon-name: "circle-user-round"; label: root.account-connected ? "Connected" : "Guest mode"; clicked => { root.navigate(4); } }
    }
    if root.tab-strip-height > 0px: TabStrip {
        x: 0px; y: root.header-height; width: root.width; height: root.tab-strip-height;
        background: root.chrome-background;
        leading: 16px;
        presenting: root.loaded && !root.watch-loading;
        draggable: root.native-header-integrated;
        drag => { root.window-header-drag(); }
    }
    Rectangle {
        x: 0; y: root.top-height; width: root.sidebar-width; height: root.height - root.top-height;
        background: root.chrome-background;
        cache-rendering-hint: root.cache-chrome;
        visible: !root.video-only && !root.theatre-active;
        // Expanded guide scrolls when short; the mini-guide always fits.
        ScrollView {
            width: parent.width; height: parent.height;
            horizontal-scrollbar-policy: always-off;
            vertical-scrollbar-policy: root.guide-compact ? always-off : as-needed;
            VerticalLayout {
                width: parent.visible-width; min-height: parent.visible-height;
                padding-left: 8px; padding-right: 8px; padding-top: 4px; padding-bottom: 12px;
                spacing: root.guide-compact ? 4px : 2px;
                Action { icon-name: "house"; label: "Home"; compact: root.guide-compact; dense: true; corner-radius: 10px; height: root.guide-compact ? 40px : 36px; selectable: true; selected: root.page == 0 && root.home-active; clicked => { root.navigate(0); } }
                if root.loaded: Action { icon-name: "play"; label: "Now playing"; compact: root.guide-compact; dense: true; corner-radius: 10px; height: root.guide-compact ? 40px : 36px; selectable: true; selected: root.page == 2; clicked => { root.navigate(2); } }
                GuideDivider {}
                if !root.guide-compact: GuideHeading { text: "You"; }
                Action { icon-name: "users"; label: "Local subscriptions"; compact: root.guide-compact; dense: true; corner-radius: 10px; height: root.guide-compact ? 40px : 36px; selectable: true; selected: root.page == 1 && LibraryUi.tab == 1; enabled: !LibraryUi.busy && LibraryUi.confirmation == 0; clicked => { root.open-local-tab(1); } }
                Action { icon-name: "list-video"; label: "Local playlists"; compact: root.guide-compact; dense: true; corner-radius: 10px; height: root.guide-compact ? 40px : 36px; selectable: true; selected: root.page == 1 && LibraryUi.tab == 0; enabled: !LibraryUi.busy && LibraryUi.confirmation == 0; clicked => { root.open-local-tab(0); } }
                if LibraryUi.history-enabled: Action { icon-name: "history"; label: "History"; compact: root.guide-compact; dense: true; corner-radius: 10px; height: root.guide-compact ? 40px : 36px; selectable: true; selected: root.page == 1 && LibraryUi.tab == 2; enabled: !LibraryUi.busy && LibraryUi.confirmation == 0; clicked => { root.open-local-tab(2); } }
                Action { icon-name: "clapperboard"; label: root.local-file-busy ? "Opening file…" : "Open video file"; compact: root.guide-compact; dense: true; corner-radius: 10px; height: root.guide-compact ? 40px : 36px; enabled: !root.native-video-child && !root.local-file-busy && !LibraryUi.busy; clicked => { root.open-video-file(); } }
                if root.local-file-cancellable: Action { label: "Cancel file selection"; icon-name: "chevron-left"; compact: root.guide-compact; dense: true; corner-radius: 10px; height: root.guide-compact ? 40px : 36px; clicked => { root.cancel-local-file(); } }
                if !root.guide-compact: GuideDivider {}
                if !root.guide-compact: GuideHeading { text: "Explore"; }
                if !root.guide-compact: Action { icon-name: "music"; label: "Music"; accessible-label: "Search YouTube for music"; dense: true; corner-radius: 10px; height: 36px; enabled: !root.busy && !root.account-busy && !root.native-video-child; clicked => { search.text = "Music"; root.search(search.text); } }
                if !root.guide-compact: Action { icon-name: "gamepad-2"; label: "Gaming"; accessible-label: "Search YouTube for gaming"; dense: true; corner-radius: 10px; height: 36px; enabled: !root.busy && !root.account-busy && !root.native-video-child; clicked => { search.text = "Gaming"; root.search(search.text); } }
