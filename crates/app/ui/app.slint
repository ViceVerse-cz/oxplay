                    rate(like) => { root.account-rating(like); }
                }
                Action { variant: ActionVariant.secondary; width: 36px; height: 36px; horizontal-stretch: 0; compact: true; icon-name: "list-video"; label: "Video chapters"; enabled: root.loaded && root.remote-video && !root.native-video-child; clicked => { root.prepare-native-overlay(); chapters-popup.show(); } }
                share-button := Action { variant: ActionVariant.secondary; width: 76px; height: 36px; horizontal-stretch: 0; label: "Share"; enabled: root.share-available; clicked => { root.show-share(); } }
                Action { variant: ActionVariant.secondary; width: 92px; height: 36px; horizontal-stretch: 0; label: "Save"; icon-name: "plus"; enabled: root.remote-video && root.loaded && !root.busy && !LibraryUi.busy && !root.account-playback-active && !root.native-video-child; clicked => { root.show-local-save(); } }
                Action { variant: ActionVariant.secondary; width: 36px; height: 36px; horizontal-stretch: 0; compact: true; icon-name: "info"; label: "Playback details"; enabled: root.loaded && !root.watch-loading; checkable: true; selected: root.show-info; clicked => { root.prepare-native-overlay(); root.show-info = !root.show-info; } }
            }

        }
        if root.watch-loading && !root.video-only: VerticalLayout {
            x: video.x; y: watch-controls.y + watch-controls.height + 12px; width: video.width; height: 78px;
            padding: 12px; spacing: 8px; alignment: start;
            Rectangle { height: 12px; width: parent.width * 0.9; border-radius: 3px; background: Colors.raised; horizontal-stretch: 0; }
            Rectangle { height: 12px; width: parent.width * 0.7; border-radius: 3px; background: Colors.raised; horizontal-stretch: 0; }
        }
        watch-details := WatchDetails {
            x: video.x; y: watch-controls.y + watch-controls.height + 12px;
            width: video.width;
            visible: root.watching && !root.video-only && root.loaded && root.remote-video;
            height: root.watch-loading && !root.video-only ? 78px : self.visible ? self.preferred-height : 0px;
            busy: root.busy;
            page-loaded => {
                if root.watching && !root.video-only && root.remote-video && !root.account-playback-active && CommentsUi.has-loaded {
                    watch.content-y = max(min(0px, watch.visible-height - watch.content-height), root.watch-inset - (watch-details.y + watch-details.comments-y));
                }
            }
        }
        related-parking := FocusScope {
            x: related.x; y: related.y; width: related.width; height: related.height;
            // Keep enabled to receive FocusOut: pinned Slint ignores even
            // FocusOut on a disabled scope, leaving has-focus stale. Rust
            // guards every request by active surface; this is never a Tab/click stop.
            focus-on-tab-navigation: false; focus-on-click: false;
            focus-lost => { root.feed-parking-lost(); }
            key-pressed(event) => {
                let command = CatalogKeys.command(event);
                let index = root.feed-focus-surface == 1 && root.feed-focus-target >= 0 ? root.feed-focus-target : min(root.watch-videos.length - 1, max(0, floor((-related.content-y + root.related-clip-top) / 106px)));
                if command >= 0 && root.feed-key(1, index, command) { return accept; }
                root.feed-focus-cancel();
                return reject;
            }
            Rectangle { border-width: parent.has-focus ? 2px : 0px; border-color: Colors.focus; border-radius: 12px; background: transparent; }
        }
        related := ListView {
            x: root.wide-related ? video.x + video.width + 24px : video.x;
            y: root.wide-related ? root.watch-inset : watch-details.y + watch-details.height + 20px;
            width: root.wide-related ? watch.visible-width - self.x : video.width;
            height: root.wide-related ? watch.visible-height - root.watch-inset : max(318px, watch.visible-height * 0.65);
            visible: root.watching && !root.video-only;
            horizontal-scrollbar-policy: always-off;
            // Opt-in experiment: cache each virtualized related card independently.
            // Thumbnail/model, theme, size, hover and focus changes invalidate its layer.
            for item[index] in root.watch-videos: VideoCard {
                cache-rendering-hint: root.cache-related;
                enabled: !root.native-video-child;
                height: 106px; item: item; compact: true;
                focus-request: root.watching && !root.video-only && root.feed-focus-surface == 1 && root.feed-focus-target == index ? root.feed-focus-serial : 0;
                focus-delivery: root.feed-focus-delivery;
                focus-ready(serial) => { root.feed-focus-ready(1, index, item.kind, item.id, serial); }
                keyboard-move(command) => { return root.feed-key(1, index, command); }
                card-focus(focused) => { root.feed-card-focus(1, index, item.kind, item.id, focused); }
                claim-focus(serial) => { return root.feed-focus-claim(1, index, item.kind, item.id, serial); }
                focus-complete(serial, focused) => { root.feed-focus-complete(serial, focused); }
                clicked => { root.select-related(index); }
                open-in-new-tab => { TabsUi.open(1, index); }
                menu-action(action) => { if CardMenuUi.action(1, index, action) { root.open-local-save(); } }
            }
        }
    }
    if root.native-video-child && root.video-only: Rectangle {
        x: 0; y: root.height - 16px; width: root.width; height: 16px; background: Colors.canvas;
        Text { x: 8px; width: parent.width - 16px; height: parent.height; text: "DIAGNOSTIC — native child video; local only; layering, timing and performance unqualified"; color: #c58c44; font-size: 11px; overflow: elide; }
    }
    // Drawn after page content so it overlays feeds and the watch page. The
    // field is disabled for the native child, so it never opens above that view.
    suggestions := SearchSuggestions {
        x: search.x; y: search.y + search.height + 4px; width: search.width;
        field-focused: search.has-focus; field-text: search.text;
        allowed: !root.video-only && !root.native-video-child;
        preview(text) => { search.text = text; }
        activate(text) => { search.text = text; suggestions.close(); root.search(text); }
    }
    // Card-menu confirmation ("Link copied"), above feeds and the watch page.
    if !root.video-only: CardToast {
        x: root.sidebar-width + (root.width - root.sidebar-width - self.width) / 2;
        y: root.height - self.height - 28px;
    }
    // Popups are composited above the shared scene. Dim only modal content,
    // leaving transient playback settings and tooltips lightweight.
    if shortcuts-popup.is-open || jump-popup.is-open || chapters-popup.is-open || share-popup.is-open || save-popup.is-open || status-popup.is-open: Rectangle {
        x: 0px; y: 0px; width: root.width; height: root.height;
        background: #00000070;
    }
    }
}
