    private property <string> displayed-status: root.diagnostic-fixture-label != "" ? root.diagnostic-fixture-label + " " + root.current-status : root.current-status;
    out property <bool> status-message-open: status-popup.is-open;
    out property <string> status-message-text: root.message-text;
    public function show-status-message() {
        root.prepare-native-overlay();
        root.message-text = (root.diagnostic-fixture-label != "" ? root.diagnostic-fixture-label + "\n\n" : "") + (root.diagnostic-warning != "" && !root.native-video-child ? root.diagnostic-warning + "\n\n" + root.status : root.current-status);
        root.message-recovery-serial = root.recovery-serial;
        status-popup.show();
    }
    public function show-captions() { root.prepare-native-overlay(); captions-popup.show(); }
    public function show-local-save() -> bool {
        if SaveUi.begin() { root.prepare-native-overlay(); save-popup.show(); return true; }
        return false;
    }
    public function close-local-save() { save-popup.close(); }
    preferred-width: 1320px; preferred-height: 860px; min-width: root.picture-in-picture ? 360px : 760px; min-height: root.picture-in-picture ? 240px : 600px;
    background: Colors.canvas;
    default-font-size: 14px;
    forward-focus: shortcuts;
    out property <bool> search-active: search.has-focus;
    out property <bool> browse-active: shortcuts.has-focus;
    out property <bool> player-active: focus.has-focus;
    in property <bool> cache-chrome: false;
    in property <bool> cache-search: false;
    in property <bool> cache-related: false;
    in property <bool> remote-video;
    in property <bool> native-video-child: false;
    out property <length> native-clip-x: watch.x;
    out property <length> native-clip-y: watch.y;
    out property <length> native-clip-width: watch.visible-width;
    out property <length> native-clip-height: watch.visible-height;
    private property <bool> native-overlay-open: save-popup.is-open || playback-settings.is-open || captions-popup.is-open || video-details.is-open || status-popup.is-open;
    out property <bool> native-child-visible: native-video-child && watching && loaded && (!show-info || fullscreen-active) && !native-overlay-open;
    callback native-child-hide();
    function prepare-native-overlay() { if root.native-video-child { root.native-child-hide(); } }
    changed native-overlay-open => { root.prepare-native-overlay(); }
    changed show-info => { root.prepare-native-overlay(); }
    changed loaded => { root.prepare-native-overlay(); }
    in-out property <int> quality-index;
