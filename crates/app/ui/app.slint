    out property <int> feed-thumbnail-end: page == 0 && feed.visible-width > 0px && feed.visible-height > 0px ? min(videos.length, max(0, ceil((-feed.content-y - feed-inset + feed.visible-height) / row-height)) * columns) : 0;
    out property <int> feed-thumbnail-first: page == 0 && feed.visible-width > 0px && feed.visible-height > 0px ? min(feed-thumbnail-end, max(0, floor((-feed.content-y - feed-inset - (row-height - 100px)) / row-height) + 1) * columns) : 0;
    private property <bool> watching: page == 2;
    private property <length> sidebar-width: video-only || theatre-active ? 0px : expanded-sidebar && root.width >= 1100px ? 200px : 56px;
    private property <bool> guide-compact: root.sidebar-width < 100px;
    private property <length> header-height: video-only ? 0px : 48px;
    // Watch tabs extend the header with one slim strip only when useful.
