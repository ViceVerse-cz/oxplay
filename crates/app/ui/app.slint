    callback relative-seek(float);
    callback mute();
    callback speed(float);
    callback media-wake();
    callback worker-wake();
    callback caption-cache-wake();
    callback toggle-controls();
    callback watch-visibility-changed();
    callback cancel-playback-focus();
    callback search-focus-changed(bool);
    changed search-active => { root.search-focus-changed(root.search-active); }
    changed progress-visible => { root.watch-visibility-changed(); }
    changed columns => { root.columns-changed(root.columns); }
    changed first-row => { root.refresh-visible(); }
    changed last-row => { root.refresh-visible(); }
    changed feed-thumbnail-first => { root.refresh-visible(); }
    changed feed-thumbnail-end => { root.refresh-visible(); }
    changed related-first => { root.refresh-visible(); }
    changed related-last => { root.refresh-visible(); }
    changed page => { if root.page != 0 { root.home-leave(); } if root.picture-in-picture && root.page != 2 { root.exit-picture-in-picture(); } root.prepare-native-overlay(); if root.page != 1 { LibraryUi.confirmation = 0; } root.feed-focus-cancel(); root.refresh-visible(); }
    changed video-only => {
        if root.video-only {
            // Retire parking before the related surface disappears.
            // Transfer only retiring related focus, without resetting the saved
            // outer watch offset or stealing focus from search/player controls.
            if root.watching && (related-parking.has-focus || root.feed-focused-index >= 0) { focus.focus(); }
            root.feed-focus-cancel();
        }
        root.restore-watch-scroll();
        root.refresh-visible();
    }
    changed theme => {
        Colors.dark = root.theme == 0 ? root.system-dark : root.theme == 2;
        Palette.color-scheme = Colors.dark ? ColorScheme.dark : ColorScheme.light;
    }
    changed system-dark => {
        Colors.dark = root.theme == 0 ? root.system-dark : root.theme == 2;
        Palette.color-scheme = Colors.dark ? ColorScheme.dark : ColorScheme.light;
    }
    public function refresh-visible() {
        if root.page == 0 {
            root.visible-range(root.first-row * root.columns, root.last-row * root.columns, root.feed-thumbnail-first, root.feed-thumbnail-end);
        } else if root.page == 2 && !root.video-only {
            root.visible-range(root.related-first, root.related-last, -1, -1);
        } else { root.visible-range(0, 0, -1, -1); }
    }
    public function focus-player() { root.prepare-native-overlay(); root.saved-watch-offset = 0px; watch.content-y = 0px; focus.focus(); }
    function restore-watch-scroll() {
        watch.content-y = root.video-only ? 0px : max(min(root.saved-watch-offset, 0px), min(0px, watch.visible-height - watch.content-height));
    }
    public function focus-search() { if !root.native-video-child { search.focus(); } }
    public function focus-browse() { shortcuts.focus(); }
    public function park-feed-focus(surface: int) {
        if surface == 0 { feed-parking.focus(); }
        else if surface == 1 { related-parking.focus(); }
    }
    public function reveal-feed-item(index: int) {
        let top = floor(index / root.columns) * root.row-height;
        if top + feed.content-y < 0px { feed.content-y = -top; }
        if top + root.row-height + feed.content-y > feed.visible-height {
            feed.content-y = min(0px, feed.visible-height - top - root.row-height);
        }
        root.refresh-visible();
    }
    public function reveal-related-item(index: int) {
        // At compact widths the list is below the player. Reveal its outer
        // viewport first, then the requested row inside the same ListView.
        if related.y + watch.content-y < 0px { watch.content-y = -related.y; }
        if related.y + related.height + watch.content-y > watch.visible-height {
            watch.content-y = min(0px, watch.visible-height - related.y - related.height);
        }
        watch.content-y = max(min(0px, watch.content-y), min(0px, watch.visible-height - watch.content-height));
        root.saved-watch-offset = watch.content-y;
        let top = index * 106px;
        if top + related.content-y < root.related-clip-top { related.content-y = root.related-clip-top - top; }
        if top + 106px + related.content-y > root.related-clip-bottom {
            related.content-y = min(0px, root.related-clip-bottom - top - 106px);
        }
        root.refresh-visible();
    }
    shortcuts := FocusScope {
    x: 0; y: 0; width: root.width; height: root.height;
    // Neutral startup focus belongs to the stable shared shell. Search keeps
    // its normal caret when explicitly reached by slash, Tab, click or focus().
    // This ancestor is not an extra stop in the interactive Tab order.
    focus-on-tab-navigation: false;
    focus-on-click: false;
    key-pressed(event) => {
        // Child widgets receive keys first, but TextInput rejects some special
        // keys (including Escape). Do not turn their bubbling events into media
        // commands while any editor/IME owns focus. Popup default handling stays
        // in Slint because rejected events continue through its normal path.
        if TextInputInterface.text-input-focused { return reject; }
        if event.modifiers.control || event.modifiers.alt || event.modifiers.meta { return reject; }
        if event.text == "/" { if !root.picture-in-picture && !root.native-video-child { search.focus(); } return accept; }
        if root.watching {
            if event.text == " " || event.text == "k" { root.toggle-pause(); return accept; }
            if event.text == "j" { root.relative-seek(-10); return accept; }
            if event.text == "l" { root.relative-seek(10); return accept; }
            if event.text == Key.LeftArrow { root.relative-seek(-5); return accept; }
            if event.text == Key.RightArrow { root.relative-seek(5); return accept; }
            if event.text == Key.UpArrow { root.volume(min(100, root.volume-level + 5)); return accept; }
            if event.text == Key.DownArrow { root.volume(max(0, root.volume-level - 5)); return accept; }
            if event.text == "m" { root.mute(); return accept; }
            if event.text == "f" { root.fullscreen(); return accept; }
            if event.text == "p" { root.picture-in-picture-toggle(); return accept; }
            if event.text == Key.Escape { root.exit-fullscreen(); return accept; }
        }
        return reject;
    }
    // One persistent host; scrolling moves the existing image, never the player.
    watch := ScrollView {
        x: root.video-only ? 0px : root.sidebar-width + 28px;
        y: root.video-only ? 0px : root.top-height + 20px;
        width: root.video-only ? root.width : root.width - self.x - 28px;
        height: root.video-only ? root.height : root.height - self.y - 48px;
        visible: root.watching;
        horizontal-scrollbar-policy: always-off;
        vertical-scrollbar-policy: root.video-only ? always-off : as-needed;
        content-width: self.visible-width;
        content-height: root.video-only ? self.visible-height : max(self.visible-height, max(watch-controls.y + watch-controls.height + 16px, related.y + related.height + (root.width >= 1240px ? 0px : 16px)));
        changed content-y => {
            if root.video-only && self.content-y != 0px { self.content-y = 0px; }
        }
        // Preserve the user's offset independently of native fullscreen resize
        // clamping, then reapply it against the restored viewport dimensions.
        scrolled => { root.prepare-native-overlay(); if !root.video-only { root.saved-watch-offset = self.content-y; } }
        changed visible-height => { root.restore-watch-scroll(); }
        changed content-height => { root.restore-watch-scroll(); }
        // Persistent video host: navigation/control changes never reconstruct media.
        video := Rectangle {
            x: 0px;
            y: 0px;
            width: root.video-only ? watch.visible-width : watch.visible-width - (root.width >= 1240px ? 368px : 0px);
            height: root.video-only ? max(1px, watch.visible-height - (root.native-video-child || root.picture-in-picture ? 58px : 0px)) : self.width * 9 / 16;
            visible: root.watching;
            background: #000000;
            focus := FocusScope {
                width: parent.width; height: parent.height;
                TouchArea { clicked => { focus.focus(); } double-clicked => { root.fullscreen(); } }
            }
            Image { width: parent.width; height: parent.height; source: root.video-texture; image-fit: contain; }
            if root.show-info && root.watching && !root.video-only: Rectangle {
                x: 0px; y: 12px; width: video.width; height: 110px; background: #111315dd;
                Text { x: 16px; y: 10px; width: parent.width - 32px; height: parent.height - 20px; text: root.technical; color: #eeeeee; font-size: 12px; wrap: word-wrap; }
            }
        }
        watch-controls := Rectangle {
            x: video.x; y: root.video-only ? watch.visible-height - 58px : video.y + video.height + 8px;
            width: video.width; height: root.video-only ? 58px : 214px;
            visible: root.watching;
            background: root.video-only ? Colors.surface.with-alpha(0.94) : Colors.canvas;
            if root.controls-visible || root.picture-in-picture: HorizontalLayout {
                y: 0; height: 42px; spacing: 8px;
                Action { width: 40px; horizontal-stretch: 0; compact: true; icon-name: root.playback-failed || root.paused ? "play" : "pause"; label: root.can-retry-playback ? "Retry from start" : root.playback-failed ? "Playback unavailable" : root.paused ? "Play" : "Pause"; enabled: root.loaded && (!root.playback-failed || (root.can-retry-playback && root.account-retry-ready && !root.busy && !root.account-busy && (!root.recovery-available || root.recovery-ready))); clicked => { root.toggle-pause(); } }
                Slider { horizontal-stretch: 1; min-width: 80px; accessible-label: "Playback position in seconds"; minimum: 0; maximum: root.duration; value: root.position; changed(value) => { root.seek(value); } }
                Text { text: root.picture-in-picture ? root.elapsed : root.elapsed + " / −" + root.remaining; accessible-label: "Elapsed " + root.elapsed + ", remaining " + root.remaining; color: Colors.text; width: root.picture-in-picture ? 48px : 124px; horizontal-stretch: 0; vertical-alignment: center; }
                Action { width: 40px; horizontal-stretch: 0; compact: true; icon-name: root.mute-known && root.muted ? "volume-x" : "volume-2"; label: !root.mute-known ? "Audio mute state unavailable" : root.muted ? "Unmute audio" : "Mute audio"; enabled: root.mute-known; checkable: true; selected: root.mute-known && root.muted; clicked => { root.mute(); } }
                // Keep the primary row usable at the narrow watch breakpoint.
                // Volume remains available in settings when this slider is absent.
                if watch-controls.width >= 700px: Slider { horizontal-stretch: 0; accessible-label: "Volume percent"; width: 100px; minimum: 0; maximum: 100; value: root.volume-level; changed(value) => { root.volume(value); } }
                if !root.picture-in-picture: Action { width: 40px; horizontal-stretch: 0; compact: true; icon-name: "captions"; label: root.account-playback-active ? "Account captions unavailable" : root.remote-video ? "Choose guest captions" : "Cycle local subtitles"; clicked => { if root.remote-video { root.show-captions(); } else { root.subtitles(); } } }
                if !root.picture-in-picture: Action { width: 40px; horizontal-stretch: 0; compact: true; icon-name: "settings"; label: "Playback settings"; clicked => { root.prepare-native-overlay(); playback-settings.show(); } }
                Action { width: 40px; horizontal-stretch: 0; compact: true; icon-name: "picture-in-picture-2"; label: root.picture-in-picture ? "Return to main window (P or Esc)" : root.pip-available ? "Picture in picture (P)" : "Picture in picture unavailable on this window backend"; enabled: root.picture-in-picture || (root.pip-available && root.loaded && !root.fullscreen-active); checkable: true; selected: root.picture-in-picture; clicked => { root.picture-in-picture-toggle(); } }
                if !root.picture-in-picture: Action { width: 40px; horizontal-stretch: 0; compact: true; icon-name: "maximize"; label: "Toggle fullscreen"; clicked => { root.fullscreen(); } }
            }
            if !root.video-only: Text { x: 0; y: 54px; height: 54px; width: parent.width; text: root.video-title; wrap: word-wrap; color: Colors.text; font-size: 21px; font-weight: 600; overflow: elide; }
            if !root.video-only: Text { x: 0; y: 116px; height: 22px; width: parent.width; text: root.video-channel; overflow: elide; color: Colors.muted; font-size: 14px; }
            if !root.video-only: HorizontalLayout {
                y: 154px; height: 36px; spacing: 8px;
                Action { width: 40px; horizontal-stretch: 0; compact: true; icon-name: "library-big"; label: "Description and public comments"; enabled: root.remote-video && root.loaded && !root.account-playback-active; clicked => { root.show-video-details(); } }
                Rectangle { horizontal-stretch: 1; }
                if root.account-connected: Action { label: !root.rating-known ? "Check like" : root.account-liked ? "Unlike on YouTube" : "Like on YouTube"; enabled: !root.account-busy && !root.account-pending; clicked => { root.account-rating(); } }
                Action { width: 96px; horizontal-stretch: 0; label: "Save"; icon-name: "plus"; enabled: root.remote-video && root.loaded && !root.busy && !LibraryUi.busy && !root.account-playback-active && !root.native-video-child; clicked => { root.show-local-save(); } }
