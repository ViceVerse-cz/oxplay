            Text { text: "Default maximum quality"; color: Colors.text; font-size: 16px; font-weight: 600; height: 26px; }
            ConfirmedChoice { max-width: 360px; accessible-label: "Default maximum quality"; model: ["2160p (4K)", "1440p", "1080p", "720p", "480p", "360p", "240p", "144p"]; acknowledged-index: root.default-quality-index; choose(index) => { root.default-quality(index); } }
            Text { text: "Applies to new videos. The current video's quality is controlled on its watch page. Above 1080p YouTube usually offers VP9 or AV1, which some machines cannot decode in hardware."; color: Colors.muted; wrap: word-wrap; }
            Rectangle { height: 1px; background: Colors.border; }
            Text { text: "Privacy by default"; color: Colors.text; font-size: 16px; font-weight: 600; height: 26px; }
            Text { text: "Oxplay does not send telemetry or keep local watch history by default. YouTube still receives requests when you search or play a video."; color: Colors.muted; wrap: word-wrap; }
            ConfirmedToggle { text: "Show comments and load the first page automatically"; acknowledged-checked: CommentsUi.enabled; enabled: !LibraryUi.busy && LibraryUi.confirmation == 0; choose(checked) => { CommentsUi.set-enabled(checked); } }
            Text { text: "Public comments load when you open a guest video. Turning this off cancels comment requests and hides comments. No account comments are fetched."; color: Colors.muted; wrap: word-wrap; font-size: 12px; }
            ConfirmedToggle { text: "Keep watch history on this device"; acknowledged-checked: LibraryUi.history-enabled; enabled: !LibraryUi.busy && LibraryUi.confirmation == 0; choose(checked) => { LibraryUi.history(checked); } }
            Text { text: "When enabled, History appears in the sidebar. Its retention and deletion controls are kept there. Local history is never uploaded to your YouTube account."; color: Colors.muted; wrap: word-wrap; }
            Text { text: "Searches you submit are kept with this history and suggested again. When history is off, they are remembered only until you quit. Clearing history also removes them."; color: Colors.muted; wrap: word-wrap; font-size: 12px; }
            ConfirmedToggle { text: "Show search suggestions from YouTube"; acknowledged-checked: SearchSuggestionsUi.youtube-enabled; enabled: !LibraryUi.busy && LibraryUi.confirmation == 0; choose(checked) => { SearchSuggestionsUi.set-youtube-enabled(checked); } }
            Text { text: "While you type in the search box, the text is sent to YouTube to get suggestions, without your account cookies. Turn this off to see only searches from this device."; color: Colors.muted; wrap: word-wrap; font-size: 12px; }
            Text { text: "Saved video artwork"; color: Colors.text; font-size: 16px; font-weight: 600; height: 26px; }
            ConfirmedChoice { max-width: 360px; accessible-label: "Saved video artwork cache"; enabled: !LibraryUi.busy && LibraryUi.confirmation == 0; model: ["Off — remove cached artwork", "Up to 32 MiB", "Up to 128 MiB", "Up to 256 MiB"]; acknowledged-index: root.thumbnail-cache-index; choose(index) => { root.thumbnail-cache-changed(index); } }
            Text { text: "Keep artwork from guest browsing on this device. These images can reveal browsing interests even when history is off. Home reads them without contacting YouTube. Clear local data removes them with your local library."; color: Colors.muted; wrap: word-wrap; }
            Text { text: "Autoplay, video thumbnail previews and background refresh are off. Public playback uses guest requests."; color: Colors.muted; wrap: word-wrap; }
            Rectangle { height: 1px; background: Colors.border; }
            Text { text: "Ambient mode"; color: Colors.text; font-size: 16px; font-weight: 600; height: 26px; }
            ConfirmedToggle { text: "Glow behind the video on the watch page"; acknowledged-checked: root.ambient-mode; choose(checked) => { root.ambient-mode-changed(checked); } }
            ConfirmedChoice { max-width: 360px; accessible-label: "Ambient glow size"; enabled: root.ambient-mode; model: ["Small", "Medium", "Large", "Extra large"]; acknowledged-index: root.glow-size; choose(index) => { root.glow-size-changed(index); } }
            Text { text: "The glow follows the picture's colours and is shown only with the dark theme. A larger glow reaches further beyond the video."; color: Colors.muted; font-size: 12px; wrap: word-wrap; }
            Rectangle { height: 1px; background: Colors.border; }
            Text { text: "Keyboard shortcuts"; color: Colors.text; font-size: 16px; font-weight: 600; height: 26px; }
            Text { text: "Ctrl / Cmd + O  Open video file\nCtrl + Tab / Ctrl + Shift + Tab  Next / previous video tab\nCtrl / Cmd + W  Close the video tab\nMiddle-click, Cmd/Ctrl + click or right-click a video  Open in a new tab\nRight-click, Menu key or Shift + F10 on a video  Copy link, title or thumbnail; open channel; save\n/  Focus search · ?  Show all shortcuts\nSpace or K  Play / pause\nG  Jump to time\nJ / L  Back / forward 10 seconds\n← / →  Back / forward 5 seconds\n0 – 9  Jump to 0–90 %\nShift + < / >  Slower / faster\n↑ / ↓  Volume\nM  Mute\nF  Fullscreen · T  Theatre · P  Picture in picture\nEsc  Return to the main player"; color: Colors.text; wrap: word-wrap; }
            Text { text: "Playback shortcuts work with the player focused. They stay inactive while you type in a text field."; color: Colors.muted; font-size: 12px; wrap: word-wrap; }
            Rectangle { height: 1px; background: Colors.border; }
            HorizontalLayout { height: 36px; Action { icon-name: "info"; label: "Connection and playback details"; variant: ActionVariant.secondary; height: 36px; width: 290px; horizontal-stretch: 0; clicked => { root.show-status-message(); } } Rectangle { horizontal-stretch: 1; } }
            Text { text: "About Oxplay"; color: Colors.text; font-size: 16px; font-weight: 600; height: 26px; }
            Text { text: "Independent, open-source software. Not affiliated with YouTube or Google. Experimental release; playback and platform validation are in progress. GPL-3.0-or-later."; color: Colors.muted; wrap: word-wrap; }
            Rectangle { vertical-stretch: 1; }
        }
        }
    }
    if root.page == 4 && !root.native-video-child: Rectangle {
        x: root.sidebar-width + 36px; y: root.top-height + 24px; width: root.width - self.x - 36px; height: root.height - self.y - 20px;
        ScrollView { width: parent.width; height: parent.height; horizontal-scrollbar-policy: always-off;
        VerticalLayout { width: parent.visible-width; min-height: parent.visible-height; spacing: 14px;
            Text { text: "Your YouTube account"; color: Colors.text; font-size: 24px; font-weight: 700; letter-spacing: -0.3px; height: 44px; }
            Text { text: root.account-connected ? root.account-identity : "You are browsing as a guest"; color: Colors.text; font-size: 20px; height: 32px; }
