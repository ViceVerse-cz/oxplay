            Text { y: 137px; width: parent.width; height: 84px; text: root.home-loading ? (root.home-source == 1 ? "Reading the home feed of your connected YouTube account." : "Reading your local playlists. No network request is needed.") : root.home-active && root.home-error ? (root.home-source == 1 ? root.catalog-empty-message : "Your saved library couldn’t be read. Use Refresh to try again, or open Settings for connection details.") : root.busy ? "Contacting YouTube. You can search again to cancel this request." : root.catalog-empty-message; color: Colors.muted; font-size: 14px; horizontal-alignment: center; wrap: word-wrap; overflow: elide; }
