        Text { x: 0; y: 43px; width: parent.width; overflow: elide; text: root.page == 1 ? "Collections saved on this device. Separate from your YouTube account." : root.catalog-subtitle; color: Colors.muted; font-size: 14px; height: 22px; }
        HorizontalLayout { y: 80px; height: 38px; spacing: 10px;
            if root.home-active: Action { icon-name: "history"; label: root.home-loading ? "Loading…" : "Refresh"; enabled: !root.home-loading && !root.busy; clicked => { root.home-refresh(); } }
            if root.home-active: Action { icon-name: "list-video"; label: "Local playlists"; enabled: !LibraryUi.busy; clicked => { root.open-local-tab(0); } }
            if root.guest-can-back: Action { icon-name: "chevron-left"; label: "Back"; enabled: !root.native-video-child && !root.busy; clicked => { root.guest-back(); } }
            if root.guest-scope == 0: ComboBox { accessible-label: "Search result type"; width: 170px; horizontal-stretch: 0; model: ["All results", "Videos", "Channels", "Playlists"]; current-index: root.search-kind; enabled: !root.native-video-child && !root.busy; selected(value) => { root.search-kind-changed(self.current-index); } }
            if root.guest-scope == 1: ComboBox { accessible-label: "Channel content type"; width: 170px; horizontal-stretch: 0; model: ["Videos", "Shorts", "Streams", "Playlists"]; current-index: root.channel-tab; enabled: !root.native-video-child && !root.busy; selected(value) => { root.channel-tab-changed(self.current-index); } }
            if root.guest-can-follow: Action { icon-name: "plus"; label: "Follow locally"; enabled: !root.native-video-child && !root.busy && !LibraryUi.busy; clicked => { root.follow-guest-channel(); } }
            if root.guest-scope == 2: Text { text: "Public YouTube playlist"; color: Colors.muted; vertical-alignment: center; }
            Rectangle { horizontal-stretch: 1; }
