            x: root.width >= 1240px ? video.x + video.width + 24px : video.x;
            y: root.width >= 1240px ? 0px : watch-controls.y + watch-controls.height + 20px;
            width: root.width >= 1240px ? watch.visible-width - self.x : video.width;
            height: root.width >= 1240px ? watch.visible-height : max(318px, watch.visible-height * 0.65);
            visible: root.watching && !root.video-only;
