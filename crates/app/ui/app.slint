        || play-control.has-focus || elapsed-control.has-focus || mute-control.has-focus || (volume-control.visible && volume-control.has-focus)
        || captions-control.has-focus || (settings-control.visible && settings-control.has-focus) || pip-control.has-focus
        || (theatre-control.visible && theatre-control.has-focus)
        || (fullscreen-control.visible && fullscreen-control.has-focus) || (mini-return-control.visible && mini-return-control.has-focus) || native-overlay-open || TextInputInterface.text-input-focused;
    callback controls-activity();
    callback controls-state-changed();
    changed controls-held => { root.controls-state-changed(); }
    changed controls-visible => { root.controls-state-changed(); }
    in-out property <bool> show-info: false;
    in-out property <bool> expanded-sidebar: true;
    in-out property <bool> theatre-mode;
    private property <bool> theatre-active: root.theatre-mode && root.watching && !root.video-only && !root.native-video-child;
    private property <bool> wide-related: root.width >= 1240px && root.watch-videos.length > 0 && !root.theatre-active;
    function toggle-theatre() {
        if root.watching && !root.video-only && !root.native-video-child {
