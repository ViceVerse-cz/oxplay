                enabled: !root.native-video-child;
                height: 106px; item: item; compact: true;
                focus-request: root.watching && !root.video-only && root.feed-focus-surface == 1 && root.feed-focus-target == index ? root.feed-focus-serial : 0;
                focus-delivery: root.feed-focus-delivery;
                focus-ready(serial) => { root.feed-focus-ready(1, index, item.kind, item.id, serial); }
                keyboard-move(command) => { return root.feed-key(1, index, command); }
                card-focus(focused) => { root.feed-card-focus(1, index, item.kind, item.id, focused); }
                claim-focus(serial) => { return root.feed-focus-claim(1, index, item.kind, item.id, serial); }
                focus-complete(serial, focused) => { root.feed-focus-complete(serial, focused); }
                clicked => { root.select-video(index); }
            }
        }
    }
    save-popup := PopupWindow {
            x: (root.width - self.width) / 2; y: (root.height - self.height) / 2;
            width: 400px; height: SaveUi.destinations-paged ? 450px : 410px;
            Rectangle { background: Colors.surface; border-width: 1px; border-color: Colors.border; border-radius: 12px;
                VerticalLayout { padding: 16px; spacing: 8px;
                    Text { text: "Save to a local playlist"; color: Colors.text; font-size: 18px; font-weight: 600; height: 24px; }
                    Text { text: SaveUi.video-title; color: Colors.text; wrap: word-wrap; overflow: elide; height: 40px; }
                    Text { text: "On this device only. Your YouTube account is unchanged."; color: Colors.muted; wrap: word-wrap; height: 32px; font-size: 12px; }
                    if SaveUi.destinations-paged: Text { text: "Showing the current playlist page. More playlists are available in Local playlists."; color: Colors.muted; wrap: word-wrap; height: 32px; font-size: 12px; }
                    if SaveUi.collections.length > 0: HorizontalLayout { height: 38px; spacing: 8px;
                        destination := ComboBox { accessible-label: "Local playlist to save into"; model: SaveUi.collections; current-index: 0; enabled: !SaveUi.busy && !SaveUi.saved; horizontal-stretch: 1; }
                        Action { label: "Save"; variant: ActionVariant.primary; width: 72px; horizontal-stretch: 0; enabled: !SaveUi.busy && !SaveUi.saved && destination.current-index >= 0; clicked => { root.save-to-playlist(destination.current-index); } }
                    }
                    if SaveUi.collections.length == 0: Text { text: "Create your first local playlist"; color: Colors.text; height: 30px; }
                    playlist-name := LineEdit { accessible-label: "New local playlist name"; placeholder-text: "New playlist name"; enabled: !SaveUi.busy && !SaveUi.saved; height: 38px; accepted => { if !SaveUi.busy && !SaveUi.saved { SaveUi.create-and-save(self.text); } } }
                    Action { label: "Create and save"; variant: ActionVariant.primary; enabled: !SaveUi.busy && !SaveUi.saved; height: 36px; clicked => { SaveUi.create-and-save(playlist-name.text); } }
                    ScrollView { height: 60px; horizontal-scrollbar-policy: always-off;
                        Text { width: parent.visible-width; text: SaveUi.status; color: Colors.muted; wrap: word-wrap; }
                    }
                    Action { label: SaveUi.saved ? "Done" : "Close"; variant: ActionVariant.secondary; height: 34px; clicked => { save-popup.close(); } }
                }
            }
        }
    playback-settings := PopupWindow {
            x: (root.width - self.width) / 2; y: (root.height - self.height) / 2;
            width: 280px; height: 320px;
            Rectangle { background: Colors.surface; border-width: 1px; border-color: Colors.border; border-radius: 12px;
                VerticalLayout { padding: 16px; spacing: 10px;
                    Text { text: "Volume"; color: Colors.text; }
                    Slider { accessible-label: "Volume percent"; minimum: 0; maximum: 100; value: root.volume-level; changed(value) => { root.volume(value); } }
                    Text { text: "Playback speed"; color: Colors.text; }
                    ComboBox { accessible-label: "Playback speed"; model: ["0.5×", "1×", "1.5×", "2×"]; current-index: root.speed-index; enabled: !root.speed-busy; selected(value) => { root.speed((self.current-index + 1) * 0.5); self.current-index = root.speed-index; } }
                    Text { text: "Maximum video quality"; color: Colors.text; }
                    ComboBox { accessible-label: "Maximum video quality"; model: ["Up to 1080p", "Up to 720p", "Up to 480p", "Up to 360p", "Up to 240p", "Up to 144p"]; current-index <=> root.quality-index; enabled: root.remote-video && !root.busy; selected(value) => { root.quality(self.current-index); } }
                    Text { text: root.remote-video ? "Uses the best available stream within this limit." : "Quality selection applies to YouTube videos."; color: Colors.muted; font-size: 12px; wrap: word-wrap; }
