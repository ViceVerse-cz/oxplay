                Action { width: 40px; horizontal-stretch: 0; compact: true; icon-name: "ellipsis"; label: "Show or hide controls"; clicked => { root.toggle-controls(); } }
            }
            if (root.playback-status != "" || root.picture-in-picture) && (!root.video-only || !root.native-video-child): Text {
