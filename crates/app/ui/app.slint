            close => { status-popup.close(); }
        }
    }
    video-details := PopupWindow {
        x: (root.width - self.width) / 2; y: (root.height - self.height) / 2;
        width: min(680px, root.width - 48px); height: min(620px, root.height - 80px);
        VideoDetailsPanel { width: parent.width; height: parent.height; busy: root.busy; close => { video-details.close(); } }
    }
    if root.page == 1: LibraryPage {
        x: root.sidebar-width + 28px; y: root.top-height + 22px;
        width: root.width - self.x - 28px; height: root.height - self.y - 50px;
    }
    if root.page == 3: Rectangle {
        x: root.sidebar-width + 36px; y: root.top-height + 24px; width: min(720px, root.width - self.x - 36px); height: root.height - self.y - 60px;
        ScrollView { width: parent.width; height: parent.height; horizontal-scrollbar-policy: always-off;
        VerticalLayout { width: parent.visible-width; min-height: parent.visible-height; spacing: 20px;
            Text { text: "Settings"; color: Colors.text; font-size: 28px; font-weight: 700; height: 40px; }
            Text { text: "Appearance"; color: Colors.text; font-size: 18px; height: 26px; }
            ComboBox { accessible-label: "Appearance"; model: ["Follow system", "Light", "Dark"]; current-index: root.theme; selected(value) => { root.theme = self.current-index; root.preferences-changed(); } }
            Text { text: "Default maximum quality"; color: Colors.text; font-size: 18px; height: 26px; }
            ComboBox { accessible-label: "Default maximum quality"; model: ["1080p", "720p", "480p", "360p", "240p", "144p"]; current-index: root.default-quality-index; selected(value) => { root.default-quality(self.current-index); self.current-index = root.default-quality-index; } }
            Text { text: "Applies to new videos. The current video's quality is controlled on its watch page."; color: Colors.muted; wrap: word-wrap; }
            Rectangle { height: 1px; background: Colors.border; }
            Text { text: "Privacy by default"; color: Colors.text; font-size: 18px; height: 26px; }
            Text { text: "Serein does not send telemetry or keep local watch history by default. YouTube still receives requests when you search or play a video."; color: Colors.muted; wrap: word-wrap; }
            CheckBox { text: "Keep watch history on this device"; checked: LibraryUi.history-enabled; enabled: !LibraryUi.busy && LibraryUi.confirmation == 0; toggled => { LibraryUi.history(self.checked); self.checked = LibraryUi.history-enabled; } }
            Text { text: "When enabled, History appears in the sidebar. Its retention and deletion controls are kept there. Local history is never uploaded to your YouTube account."; color: Colors.muted; wrap: word-wrap; }
            Text { text: "Autoplay, video thumbnail previews and background refresh are off. Public playback uses guest requests."; color: Colors.muted; wrap: word-wrap; }
            Rectangle { height: 1px; background: Colors.border; }
            Text { text: "Keyboard shortcuts"; color: Colors.text; font-size: 18px; height: 26px; }
            Text { text: "/  Focus search\nSpace or K  Play / pause\nJ / L  Back / forward 10 seconds\n← / →  Back / forward 5 seconds\n↑ / ↓  Volume\nM  Mute\nF  Fullscreen · P  Picture in picture\nEsc  Return to the main player"; color: Colors.text; wrap: word-wrap; }
            Text { text: "Playback shortcuts work with the player focused. They stay inactive while you type in a text field."; color: Colors.muted; font-size: 12px; wrap: word-wrap; }
            Rectangle { height: 1px; background: Colors.border; }
            Text { text: "About Serein"; color: Colors.text; font-size: 18px; height: 26px; }
            Text { text: "Independent, open-source software. Not affiliated with YouTube or Google. Experimental release; playback and platform validation are in progress. GPL-3.0-or-later."; color: Colors.muted; wrap: word-wrap; }
            Rectangle { vertical-stretch: 1; }
        }
        }
    }
    if root.page == 4 && !root.native-video-child: Rectangle {
        x: root.sidebar-width + 36px; y: root.top-height + 24px; width: root.width - self.x - 36px; height: root.height - self.y - 60px;
        ScrollView { width: parent.width; height: parent.height; horizontal-scrollbar-policy: always-off;
        VerticalLayout { width: parent.visible-width; min-height: parent.visible-height; spacing: 14px;
            Text { text: "Your YouTube account"; color: Colors.text; font-size: 28px; font-weight: 700; height: 44px; }
            Text { text: root.account-connected ? root.account-identity : "You are browsing as a guest"; color: Colors.text; font-size: 20px; height: 32px; }
            if !root.account-connected: Text { text: "Connect a browser session to read and manage your YouTube subscriptions and playlists. Public search and playback work without connecting."; color: Colors.muted; wrap: word-wrap; }
            if !root.account-connected: Text { text: "Session cookies are sensitive account credentials. YouTube can associate authenticated activity with your account. Unofficial clients may stop working and may put your account at risk. Serein is not approved by YouTube or Google."; color: Colors.muted; wrap: word-wrap; }
            if !root.account-connected: Text { text: "1. Sign in with your Google account on YouTube in your browser.\n2. Export that YouTube session using the guide below.\n3. Select the exported file here. Serein verifies your account before connecting."; color: Colors.muted; wrap: word-wrap; }
            if !root.account-connected: HorizontalLayout {
                height: 40px; spacing: 12px;
                Action { label: "Sign in on YouTube"; clicked => { root.open-youtube(); } }
                Action { label: "Cookie export guide"; clicked => { root.open-export-guide(); } }
                Rectangle { horizontal-stretch: 1; }
            }
            if !root.account-connected: Text { text: "Use a dedicated browser profile if possible. Never enter your Google password or verification code here. Connecting does not upload your local collections."; color: Colors.muted; wrap: word-wrap; font-size: 12px; }
            if !root.account-connected: CheckBox { text: "I understand the risk and authorize this import"; checked <=> root.account-consent; }
            if !root.account-connected: CheckBox { text: "Remember this session using protected storage"; checked <=> root.account-remember; }
            if !root.account-connected: HorizontalLayout {
                height: 42px; spacing: 12px;
                Action { label: root.account-busy ? "Verifying session…" : "Connect with session file…"; selected: true; enabled: root.account-consent && !root.account-busy; clicked => { root.account-import(); } }
                if root.account-saved: Action { label: "Reconnect saved session"; enabled: root.account-consent && !root.account-busy; clicked => { root.account-reconnect(); } }
                Rectangle { horizontal-stretch: 1; }
            }
            Text { text: root.account-status; color: Colors.text; wrap: word-wrap; }
            if root.account-connected: Text { text: root.account-capabilities; color: Colors.muted; font-size: 12px; wrap: word-wrap; }
            if root.account-connected: HorizontalLayout {
                height: 40px; spacing: 12px;
                Action { label: "Subscriptions"; enabled: !root.account-busy; clicked => { root.account-tab(0); } }
                Action { label: "Account playlists"; enabled: !root.account-busy; clicked => { root.account-tab(1); } }
                if root.account-pending: Action { label: "Check pending change"; enabled: !root.account-busy; clicked => { root.account-reconcile(); } }
                Rectangle { horizontal-stretch: 1; }
            }
            if root.account-connected: ListView {
                vertical-stretch: 1; min-height: 100px; horizontal-scrollbar-policy: always-off;
                for item[index] in root.account-rows: Rectangle {
                    height: item.can-account-play ? 116px : 76px;
                    Action { x: 0; y: 0; width: parent.width - 190px; height: 44px; label: item.title; enabled: !root.account-busy; clicked => { root.account-open(index); } }
                    Text { x: 12px; y: 46px; width: parent.width - 202px; height: 22px; text: item.detail; color: Colors.muted; font-size: 12px; overflow: elide; }
                    if item.action != "": Action { x: parent.width - 180px; y: 10px; width: 180px; label: item.action; enabled: !root.account-busy && !root.account-pending; clicked => { root.account-action(index); } }
                    if item.can-account-play: Action { x: 0; y: 72px; width: 180px; label: "Play with account"; enabled: root.account-connected && root.account-media-available && !root.account-busy && !root.account-pending && !root.busy; clicked => { root.account-play(index); } }
                }
            }
            if root.account-more: Action { label: "Next page"; enabled: !root.account-busy; clicked => { root.account-next(); } }
            if !root.account-connected: Rectangle { vertical-stretch: 1; }
            if root.account-connected || root.account-saved || root.account-forget-needed: Text { text: "Disconnect removes Serein's credentials and account data. Your local collections are kept. This does not sign you out of Google in your browser."; color: Colors.muted; wrap: word-wrap; font-size: 12px; }
            if root.account-connected || root.account-saved || root.account-busy || root.account-forget-needed: Action { label: "Disconnect and forget session"; clicked => { root.account-disconnect(); } }
        }
        }
    }
    Rectangle { visible: !root.video-only; x: root.sidebar-width + 28px; y: root.height - 34px; width: root.width - self.x - 28px; height: 28px;
        HorizontalLayout {
            spacing: 8px;
            Text { horizontal-stretch: 1; min-width: 0px; text: root.displayed-status; color: root.native-video-child || root.diagnostic-warning != "" || root.diagnostic-fixture-label != "" ? #c58c44 : Colors.muted; font-size: 11px; overflow: elide; vertical-alignment: center; }
            if root.recovery-available: Action { horizontal-stretch: 0; width: 144px; height: 28px; label: root.recovery-label; variant: ActionVariant.secondary; enabled: root.recovery-ready && !root.busy && !root.account-busy; clicked => { root.retry-request(root.recovery-serial); } }
            Action { horizontal-stretch: 0; width: 126px; height: 28px; icon-name: "info"; label: "Message"; accessible-label: "Read full status message"; clicked => { root.show-status-message(); } }
        }
    }
    if root.native-video-child && root.video-only: Rectangle {
        x: 0; y: root.height - 16px; width: root.width; height: 16px; background: Colors.canvas;
        Text { x: 8px; width: parent.width - 16px; height: parent.height; text: "DIAGNOSTIC — native child video; local only; layering, timing and performance unqualified"; color: #c58c44; font-size: 11px; overflow: elide; }
    }
    // Popups are composited above the shared scene. Dim only modal content,
    // leaving transient playback settings and tooltips lightweight.
    if save-popup.is-open || status-popup.is-open || video-details.is-open: Rectangle {
        x: 0px; y: 0px; width: root.width; height: root.height;
        background: #00000070;
    }
    }
}
