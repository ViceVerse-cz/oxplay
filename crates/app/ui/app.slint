    callback glow-size-changed(int);
    in property <image> ambient-image;
    in property <int> ambient-margin: 10;
    in property <bool> ambient-ready;
    private property <bool> ambient-shown: root.ambient-mode && Colors.dark && root.watching && root.loaded
        && !root.video-only && !root.native-video-child && !root.watch-loading && root.watch-load-error == "" && !root.playback-failed;
    // Sampling runs only while some part of the glow can be on screen.
    out property <bool> ambient-active: root.ambient-shown
