            Image { x: (parent.width - 46px) / 2; y: 7px; width: 46px; height: 46px; source: root.busy ? @image-url("icons/search.svg") : root.page == 1 ? @image-url("icons/library-big.svg") : @image-url("icons/play.svg"); colorize: Colors.accent; }
            Text { y: 86px; width: parent.width; height: 35px; text: root.home-loading ? "Loading saved videos…" : root.home-active && root.home-error ? "Couldn’t load Home" : root.busy ? "Loading YouTube…" : root.catalog-empty-title; color: Colors.text; font-size: 22px; font-weight: 600; horizontal-alignment: center; overflow: elide; }
            Text { y: 137px; width: parent.width; height: 84px; text: root.home-loading ? "Reading your local playlists. No network request is needed." : root.home-active && root.home-error ? "Your saved library couldn’t be read. Use Refresh to try again, or open Message for details." : root.busy ? "Contacting YouTube. You can search again to cancel this request." : root.catalog-empty-message; color: Colors.muted; font-size: 14px; horizontal-alignment: center; wrap: word-wrap; overflow: elide; }
            if (root.home-active && !root.home-loading && !root.home-error) || root.catalog-title == "Find your next watch": HorizontalLayout {
                x: 0px; y: 228px; width: parent.width; height: 38px; spacing: 12px;
                Action { label: "Music"; accessible-label: "Search YouTube for music"; variant: ActionVariant.secondary; enabled: !root.busy && !root.account-busy && !root.native-video-child; clicked => { search.text = "Music"; root.search(search.text); } }
                Action { label: "Science"; accessible-label: "Search YouTube for science"; variant: ActionVariant.secondary; enabled: !root.busy && !root.account-busy && !root.native-video-child; clicked => { search.text = "Science"; root.search(search.text); } }
                Action { label: "Gaming"; accessible-label: "Search YouTube for gaming"; variant: ActionVariant.secondary; enabled: !root.busy && !root.account-busy && !root.native-video-child; clicked => { search.text = "Gaming"; root.search(search.text); } }
            }
        }
