    }
    if root.page == 3: Rectangle {
        x: root.sidebar-width + 36px; y: root.top-height + 24px; width: min(720px, root.width - self.x - 36px); height: root.height - self.y - 20px;
        ScrollView { width: parent.width; height: parent.height; horizontal-scrollbar-policy: always-off;
        VerticalLayout { width: parent.visible-width; min-height: parent.visible-height; spacing: 20px;
            Text { text: "Settings"; color: Colors.text; font-size: 24px; font-weight: 700; letter-spacing: -0.3px; height: 40px; }
