export component App inherits Window {
    title: root.picture-in-picture ? "Serein — Picture in picture" : "Serein";
    always-on-top: root.picture-in-picture;
    public function show-video-details() { root.prepare-native-overlay(); video-details.show(); }
    private property <string> message-text;
    private property <int> message-recovery-serial;
