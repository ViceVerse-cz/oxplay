    private property <length> progress-seek-top: transport.y + seek-control.y + watch.content-y;
    private property <length> progress-time-top: transport.y + transport-buttons.y + elapsed-control.y + elapsed-text.y + watch.content-y;
    out property <bool> progress-visible: video-visible && transport.visible && (
        (progress-seek-top < watch.visible-height && progress-seek-top + seek-control.height > 0px)
