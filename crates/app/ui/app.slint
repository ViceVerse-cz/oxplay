    in-out property <int> channel-tab;
    callback search-kind-changed(int);
    callback channel-tab-changed(int);
    callback guest-previous();
    callback guest-back();
    in property <bool> loaded;
    in property <string> catalog-title: "Find your next watch";
    in property <string> catalog-subtitle: "Search YouTube, or paste a video link above.";
    in property <string> catalog-empty-title: "Watch with intention";
    in property <string> catalog-empty-message: "Start with a search or a YouTube link.\nNo autoplay. No endless recommended feed.";
    in-out property <int> page: 0;
    in-out property <int> theme: 0;
    in property <bool> system-dark: true;
    in-out property <bool> controls-visible: true;
    in-out property <bool> show-info: false;
    in-out property <bool> expanded-sidebar: true;
    in-out property <bool> fullscreen-active;
    in-out property <bool> picture-in-picture;
    in property <bool> pip-available;
    out property <bool> playback-overlay-open: native-overlay-open;
    private property <bool> video-only: fullscreen-active || picture-in-picture;
    callback picture-in-picture-toggle();
    callback exit-picture-in-picture();
    public function focus-video-mode() { focus.focus(); }
    in-out property <bool> history-enabled;
    in-out property <int> selected-playlist: -1;
    in-out property <float> volume-level: 100;
    in property <bool> muted;
    in property <bool> mute-known;
    out property <length> video-width: video.width;
    out property <length> video-height: video.height;
    out property <length> video-window-x: watch.x + video.x;
    out property <length> video-window-y: watch.y + watch.content-y + video.y;
    out property <length> watch-offset: watch.content-y;
    out property <length> related-height: related.height;
    out property <int> visible-related-count: max(0, related-last - related-first);
    out property <bool> progress-visible: watching && (controls-visible || picture-in-picture) && watch-controls.y + watch.content-y < watch.visible-height && watch-controls.y + watch.content-y + 42px > 0px;
    out property <int> columns: min(6, max(1, floor((browse.width + 20px) / 270px)));
    in property <int> feed-focus-target: -1;
    in property <int> feed-focus-surface: -1;
    in property <int> feed-focus-serial;
    in property <int> feed-focus-delivery;
    in property <int> feed-focused-index: -1;
    out property <bool> feed-parking-active: feed-parking.has-focus;
    out property <bool> related-parking-active: related-parking.has-focus;
    // Logical intersection only; native occlusion/compositor state is separate.
    out property <bool> related-focused-visible: related-in-view && feed-focused-index >= 0
        && feed-focused-index * 106px + related.content-y >= related-clip-top - 1px
        && (feed-focused-index + 1) * 106px + related.content-y <= related-clip-bottom + 1px;

    out property <int> feed-page-rows: max(1, floor(feed.visible-height / row-height));
    out property <int> related-page-rows: max(1, floor((related-clip-bottom - related-clip-top) / 106px));
    // Positive intersection of thumbnail rectangles with the feed viewport.
    // Unlike first-row/last-row, this excludes prefetch and text-only rows.
    // Window occlusion and physical display clipping remain host observations.
    out property <int> feed-thumbnail-end: page == 0 && feed.visible-width > 0px && feed.visible-height > 0px ? min(videos.length, max(0, ceil((-feed.content-y + feed.visible-height) / row-height)) * columns) : 0;
    out property <int> feed-thumbnail-first: page == 0 && feed.visible-width > 0px && feed.visible-height > 0px ? min(feed-thumbnail-end, max(0, floor((-feed.content-y - (row-height - 100px)) / row-height) + 1) * columns) : 0;
    private property <bool> watching: page == 2;
    private property <length> sidebar-width: video-only ? 0px : expanded-sidebar && root.width >= 1100px ? 232px : 72px;
    private property <length> top-height: video-only ? 0px : 56px;
    private property <length> row-height: ((feed.visible-width - (columns - 1) * 20px) / columns) * 9 / 16 + 100px;
    private property <int> first-row: max(0, floor(-feed.content-y / row-height) - 1);
    private property <int> last-row: min(groups.length, ceil((-feed.content-y + feed.visible-height) / row-height) + 1);
    private property <length> related-clip-top: max(0px, -watch.content-y - related.y);
    private property <length> related-clip-bottom: min(related.visible-height, watch.visible-height - watch.content-y - related.y);
    private property <bool> related-in-view: root.watching && !root.video-only && related-clip-bottom > related-clip-top;
    private property <int> related-first: related-in-view ? max(0, floor((-related.content-y + related-clip-top) / 106px) - 1) : 0;
    private property <int> related-last: related-in-view ? min(videos.length, ceil((-related.content-y + related-clip-bottom) / 106px) + 1) : 0;
    private property <length> saved-watch-offset: 0px;
    callback search(string);
    callback select-video(int);
    callback more();
    callback navigate(int);
    callback open-local-tab(int);
    callback columns-changed(int);
    // First argument identifies the surface: 0 Home feed, 1 watch related list.
    callback feed-key(int, int, int) -> bool;
    callback feed-card-focus(int, int, string, string, bool);
    callback feed-focus-claim(int, int, string, string, int) -> bool;
    callback feed-focus-ready(int, int, string, string, int);
    callback feed-focus-complete(int, bool);
    callback feed-parking-lost();
