            x: feed.x; y: feed.y; width: feed.width; height: feed.height;
            focus-on-tab-navigation: false; focus-on-click: false;
            focus-lost => { root.feed-parking-lost(); }
            key-pressed(event) => {
                let command = CatalogKeys.command(event);
