            Action { icon-name: "users"; label: "Local subscriptions"; compact: root.sidebar-width < 100px; selectable: true; selected: root.page == 1 && LibraryUi.tab == 1; enabled: !LibraryUi.busy && LibraryUi.confirmation == 0; clicked => { root.open-local-tab(1); } }
            Action { icon-name: "list-video"; label: "Local playlists"; compact: root.sidebar-width < 100px; selectable: true; selected: root.page == 1 && LibraryUi.tab == 0; enabled: !LibraryUi.busy && LibraryUi.confirmation == 0; clicked => { root.open-local-tab(0); } }
            if LibraryUi.history-enabled: Action { icon-name: "history"; label: "History"; compact: root.sidebar-width < 100px; selectable: true; selected: root.page == 1 && LibraryUi.tab == 2; enabled: !LibraryUi.busy && LibraryUi.confirmation == 0; clicked => { root.open-local-tab(2); } }
            if root.loaded: Action { icon-name: "play"; label: "Now playing"; compact: root.sidebar-width < 100px; selectable: true; selected: root.page == 2; clicked => { root.navigate(2); } }
            Rectangle { height: 1px; background: Colors.border; }
            Action { enabled: !root.native-video-child; icon-name: "circle-user-round"; label: "YouTube account"; compact: root.sidebar-width < 100px; selectable: true; selected: root.page == 4; clicked => { root.navigate(4); } }
            Rectangle { vertical-stretch: 1; }
            Action { icon-name: "settings"; label: "Settings"; compact: root.sidebar-width < 100px; selectable: true; selected: root.page == 3; clicked => { root.navigate(3); } }
            if root.sidebar-width > 100px: Text { text: "A quieter place to watch.\nPrivate by default."; color: Colors.muted; font-size: 12px; wrap: word-wrap; height: 48px; }
        }
    }
    browse := Rectangle {
        x: root.sidebar-width + 28px; y: root.top-height + 22px;
