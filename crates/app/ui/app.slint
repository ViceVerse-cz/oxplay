        width: min(440px, root.width - 48px); height: 200px;
        CaptionSelector { width: parent.width; height: parent.height; worker-busy: root.busy; close => { captions-popup.close(); } }
    }
    status-popup := PopupWindow {
        x: (root.width - self.width) / 2; y: (root.height - self.height) / 2;
        width: min(560px, root.width - 48px); height: min(320px, root.height - 80px);
        StatusMessage {
            width: parent.width; height: parent.height; message: root.message-text;
            recovery-available: root.recovery-available && root.message-recovery-serial > 0 && root.message-recovery-serial == root.recovery-serial;
            recovery-ready: root.recovery-ready && !root.busy && !root.account-busy;
            recovery-label: root.recovery-label;
