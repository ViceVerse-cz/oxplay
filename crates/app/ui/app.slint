    private property <string> current-status: root.native-video-child ? "DIAGNOSTIC — native child; local only; unqualified. " + root.status : root.diagnostic-warning != "" ? root.diagnostic-warning : root.status;
    out property <bool> status-message-open: status-popup.is-open;
    out property <string> status-message-text: root.message-text;
