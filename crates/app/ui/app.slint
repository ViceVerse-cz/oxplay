            Action { enabled: !root.native-video-child; x: parent.width - 48px; y: 1px; width: 46px; height: 40px; compact: true; icon-name: "search"; label: "Search"; clicked => { root.search(search.text); } }
        }
        Action { enabled: !root.native-video-child; x: parent.width - 156px; y: 8px; width: 140px; icon-name: "circle-user-round"; label: root.account-connected ? "Connected" : "Guest mode"; clicked => { root.navigate(4); } }
    }
