    callback close-player();
    // Centre acknowledgement of a user play/pause, like YouTube's: it pops in,
    // holds fully visible (flash-timer) and only then fades and grows out.
    private property <bool> flash-on;
    out property <bool> play-flash-visible: root.flash-on;
    private property <bool> flash-play;
    function user-toggle-pause() {
        if root.loaded && !root.playback-failed && !root.watch-loading {
            root.flash-play = root.paused;
            root.flash-on = true;
            // Start it, or push the hold out again on a quick repeated toggle.
            flash-timer.running = true;
            flash-timer.restart();
        }
        root.toggle-pause();
    }
