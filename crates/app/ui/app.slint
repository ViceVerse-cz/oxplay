                        focus-ready(serial) => { root.feed-focus-ready(0, group.start + index, item.kind, item.id, serial); }
                        keyboard-move(command) => { return root.feed-key(0, group.start + index, command); }
                        card-focus(focused) => { root.feed-card-focus(0, group.start + index, item.kind, item.id, focused); }
                        claim-focus(serial) => { return root.feed-focus-claim(0, group.start + index, item.kind, item.id, serial); }
                        focus-complete(serial, focused) => { root.feed-focus-complete(serial, focused); }
