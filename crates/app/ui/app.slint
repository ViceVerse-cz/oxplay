        root.prepare-native-overlay();
        root.message-text = (root.diagnostic-fixture-label != "" ? root.diagnostic-fixture-label + "\n\n" : "") + (root.diagnostic-warning != "" && !root.native-video-child ? root.diagnostic-warning + "\n\n" + root.status : root.current-status);
        root.message-recovery-serial = root.recovery-serial;
        status-popup.show();
    }
    public function show-captions() { root.prepare-native-overlay(); captions-popup.show(); }
    public function show-local-save() -> bool {
        if SaveUi.begin() { root.open-local-save(); return true; }
        return false;
    }
    // Rust has already captured the dialog target (current video or a card).
    function open-local-save() {
        // A destination is a local draft for this frozen dialog snapshot,
        // not an acknowledged save. Preserve it only for an in-flight save.
        if !SaveUi.busy { root.save-destination = SaveUi.collections.length > 0 ? 0 : -1; }
        root.prepare-native-overlay(); save-popup.show();
    }
    public function close-local-save() { save-popup.close(); }
    in property <bool> share-available;
