    out property <bool> native-child-visible: native-video-child && watching && loaded && (!show-info || fullscreen-active) && !native-overlay-open;
    callback native-child-hide();
    function prepare-native-overlay() { if root.native-video-child { root.native-child-hide(); } }
    changed native-overlay-open => { root.prepare-native-overlay(); }
    changed show-info => { root.prepare-native-overlay(); }
    changed loaded => { root.prepare-native-overlay(); }
    // Indexes follow oxplay_core::QualityCeiling::ALL; 2 is the 1080p default.
