    changed page => { root.restore-watch-scroll(); root.channel-avatar-context-changed(); root.controls-state-changed(); if root.video-visible { root.controls-activity(); } if root.page != 0 { root.home-leave(); } if root.picture-in-picture && root.page != 2 { root.exit-picture-in-picture(); } root.prepare-native-overlay(); if root.page != 1 { LibraryUi.confirmation = 0; } root.feed-focus-cancel(); root.refresh-visible(); }
