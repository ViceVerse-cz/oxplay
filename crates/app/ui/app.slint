    chapters-popup := PopupWindow {
        close-policy: close-on-click-outside;
        x: (root.width - self.width) / 2; y: (root.height - self.height) / 2;
        width: min(420px, root.width - 48px); height: min(400px, root.height - 48px);
        ChapterPanel { width: parent.width; height: parent.height; close => { chapters-popup.close(); root.focus-video-mode(); } }
    }
    captions-popup := PopupWindow {
        close-policy: close-on-click-outside;
