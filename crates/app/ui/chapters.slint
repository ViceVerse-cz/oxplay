import { StandardListView } from "std-widgets.slint";
import { Colors, Action, ActionVariant } from "components.slint";
export global ChaptersUi {
    in property <[StandardListViewItem]> rows;
    in property <int> epoch;
    in property <bool> available;
    in property <string> status: "No chapter metadata is available for this video.";
    callback jump(int, int);
}
export component ChapterPanel inherits Rectangle {
    callback close();
    private property <int> selected: -1;
    private property <int> selected-epoch;
    private property <int> epoch: ChaptersUi.epoch;
    changed epoch => { root.selected = -1; root.selected-epoch = 0; }
    background: Colors.dialog; border-radius: 16px;
    border-color: Colors.border; border-width: 1px;
    VerticalLayout { padding: 16px; spacing: 12px;
        HorizontalLayout { height: 40px; spacing: 8px;
            Text { text: "Chapters"; color: Colors.text; font-size: 18px; font-weight: 600; horizontal-stretch: 1; }
            Action { width: 72px; label: "Close"; variant: ActionVariant.secondary; clicked => { root.close(); } }
        }
        Text { text: ChaptersUi.status; color: Colors.muted; wrap: word-wrap; }
        StandardListView {
            accessible-label: "Video chapters";
            vertical-stretch: 1;
            model: ChaptersUi.rows;
            current-item <=> root.selected;
            current-item-changed(index) => { root.selected-epoch = ChaptersUi.epoch; }
        }
        Action {
            label: "Jump to selected chapter";
            variant: ActionVariant.primary;
            enabled: ChaptersUi.available && root.selected >= 0 && root.selected < ChaptersUi.rows.length && root.selected-epoch == ChaptersUi.epoch;
            clicked => { ChaptersUi.jump(root.selected, root.selected-epoch); }
        }
    }
}
