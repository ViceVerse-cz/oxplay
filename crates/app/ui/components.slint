import { CheckBox, ListView } from "std-widgets.slint";

export global Colors {
    in-out property <bool> dark: true;
    // One canvas tint sits over native compositor blur. Shared surfaces inherit
    // alpha; text, accents and decoded video remain fully opaque.
    in-out property <bool> translucent;
    out property <color> canvas: dark ? (translucent ? #0f0f0fb8 : #0f0f0f) : (translucent ? #ffffffc7 : #ffffff);
    out property <color> surface: dark ? (translucent ? #1c1c1cb8 : #1c1c1c) : (translucent ? #f7f7f7c7 : #f7f7f7);
    out property <color> raised: dark ? (translucent ? #272727d1 : #272727) : (translucent ? #f0f0f0d9 : #f0f0f0);
    out property <color> border: dark ? (translucent ? #ffffff24 : #333333) : (translucent ? #0000001f : #e5e5e5);
    out property <color> text: dark ? #f1f1f1 : #0f0f0f;
    out property <color> muted: dark ? #aaaaaa : #606060;
    out property <color> accent: dark ? #ff0033 : #e0002b;
    // Neutral state layers over any surface, as used by guide rows and chips.
    out property <color> hover: dark ? #ffffff1a : #0000000d;
    out property <color> pressed: dark ? #ffffff33 : #0000001a;
    out property <color> strong: dark ? #ffffff47 : #00000029;
    out property <color> selected: hover;
    // Keyboard focus and editable fields use a calm blue instead of the brand red.
    out property <color> focus: dark ? #3ea6ff : #065fd4;
    // Filled actions are monochrome pills: inverted text keeps 15:1+ contrast.
    out property <color> primary: text;
    out property <color> primary-text: dark ? #0f0f0f : #ffffff;
    out property <color> primary-hover: dark ? #d9d9d9 : #272727;
    out property <color> primary-pressed: dark ? #bfbfbf : #3f3f3f;
    out property <color> destructive: dark ? #ff8295 : #b00020;
    // Popups stay opaque above translucent chrome and video.
    out property <color> dialog: dark ? #212121 : #ffffff;
}

// A rounded, tonal drop-down. Arrow keys select the adjacent row immediately
// (on the field or in its open list); Return opens, Return/Escape closes.
export component ChoiceField inherits Rectangle {
    in property <[string]> model;
    in property <bool> enabled: true;
    in-out property <int> current-index: 0;
    in-out property <string> current-value: root.current-index >= 0 && root.current-index < root.model.length ? root.model[root.current-index] : "";
    out property <bool> has-focus: (focus.has-focus || root.popup-focused) && root.enabled;
    callback selected(string);
    private property <bool> popup-focused;
    private property <bool> pointer-focus;
    private property <length> row-height: 36px;
    private property <int> visible-rows: min(8, max(1, root.model.length));
    height: 36px;
    min-width: 96px;
    border-radius: 10px;
    background: touch.pressed ? Colors.strong : (touch.has-hover && root.enabled) || root.popup-focused ? Colors.pressed : Colors.hover;
    border-width: focus.has-focus && !root.pointer-focus ? 2px : 0px;
    border-color: Colors.focus;
    opacity: root.enabled ? 1 : 0.4;
    accessible-role: combobox;
    accessible-enabled: root.enabled;
    accessible-expandable: true;
    accessible-expanded: root.popup-focused;
    accessible-value: root.current-value;
    accessible-action-expand => { root.open(); }
    forward-focus: focus;
    function select(index: int) {
        if !root.enabled || index < 0 || index >= root.model.length { return; }
        root.current-index = index;
        root.current-value = root.model[index];
        root.selected(root.current-value);
    }
    function open() { if root.enabled && root.model.length > 0 { popup.show(); } }
    function step(delta: int) -> EventResult {
        root.select(clamp(root.current-index + delta, 0, root.model.length - 1));
        return accept;
    }
    focus := FocusScope {
        enabled: root.enabled;
        focus-gained(reason) => { root.popup-focused = false; }
        focus-lost => { root.pointer-focus = false; }
        key-pressed(event) => {
            if event.text == Key.UpArrow { return root.step(-1); }
            if event.text == Key.DownArrow { return root.step(1); }
            if event.text == Key.Return || event.text == " " { root.open(); return accept; }
            return reject;
        }
    }
    Text {
        x: 14px; width: parent.width - 44px; height: parent.height;
        text: root.current-value; color: Colors.text; font-size: 14px;
        vertical-alignment: center; overflow: elide;
    }
    Image {
        x: parent.width - 30px; y: (parent.height - self.height) / 2; width: 16px; height: 16px;
        source: @image-url("icons/chevron-down.svg"); colorize: Colors.muted;
        transform-rotation: root.popup-focused ? 180deg : 0deg;
    }
    touch := TouchArea {
        enabled: root.enabled; mouse-cursor: root.enabled ? pointer : default;
        clicked => { root.pointer-focus = true; focus.focus(); root.open(); }
    }
    popup := PopupWindow {
        x: 0px; y: root.height + 4px;
        width: max(root.width, 160px);
        height: root.visible-rows * root.row-height + 8px;
        close-policy: close-on-click-outside;
        forward-focus: list-focus;
        Rectangle {
            background: Colors.dialog; border-radius: 12px;
            border-width: 1px; border-color: Colors.border;
            clip: true;
            list-focus := FocusScope {
                focus-gained(reason) => { root.popup-focused = true; }
                focus-lost => { root.popup-focused = false; }
                key-pressed(event) => {
                    if event.text == Key.UpArrow { return root.step(-1); }
                    if event.text == Key.DownArrow { return root.step(1); }
                    if event.text == Key.Return || event.text == Key.Escape { popup.close(); focus.focus(); return accept; }
                    return reject;
                }
                ListView {
                    x: 4px; y: 4px; width: parent.width - 8px; height: parent.height - 8px;
                    horizontal-scrollbar-policy: always-off;
                    content-y: -max(0, root.current-index - root.visible-rows + 1) * root.row-height;
                    for value[index] in root.model: Rectangle {
                        height: root.row-height;
                        border-radius: 8px;
                        background: row-touch.has-hover ? Colors.hover : index == root.current-index ? Colors.selected : transparent;
                        Text {
                            x: 12px; width: parent.width - 24px; height: parent.height;
                            text: value; color: Colors.text; font-size: 14px;
                            font-weight: index == root.current-index ? 600 : 400;
                            vertical-alignment: center; overflow: elide;
                        }
                        row-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.select(index); popup.close(); root.pointer-focus = true; focus.focus(); }
                        }
                    }
                }
            }
        }
    }
}
// A controlled selector keeps its external acknowledgement binding alive even
// after the field assigns current-index during user navigation.
export component ConfirmedChoice inherits ChoiceField {
    in property <int> acknowledged-index;
    private property <string> acknowledged-value: root.acknowledged-index >= 0 && root.acknowledged-index < root.model.length ? root.model[root.acknowledged-index] : "";
    callback choose(int);
    current-index: root.acknowledged-index;
    current-value: root.acknowledged-value;
    function synchronize-acknowledgement() {
        // select() changes both fields before invoking selected. An
        // index-only A -> B -> A rollback can coalesce its changed callback,
        // leaving value B to reverse-select the rejected row next event turn.
        root.current-index = root.acknowledged-index;
        root.current-value = root.acknowledged-value;
    }
    changed acknowledged-index => { root.synchronize-acknowledgement(); }
    changed acknowledged-value => { root.synchronize-acknowledgement(); }
    selected(value) => {
        root.choose(root.current-index);
        root.synchronize-acknowledgement();
    }
}
// Boolean controls have the same imperative-write binding loss as selectors.
export component ConfirmedToggle inherits CheckBox {
    in property <bool> acknowledged-checked;
    callback choose(bool);
    checked: root.acknowledged-checked;
    changed acknowledged-checked => { root.checked = root.acknowledged-checked; }
    toggled => {
        root.choose(root.checked);
        root.checked = root.acknowledged-checked;
    }
}
export enum ActionVariant { quiet, primary, secondary, destructive }
export component Action inherits Rectangle {
    out property <bool> has-focus: focus.has-focus;
    in property <string> label;
    in property <string> icon-name;
    in property <bool> selected;
    in property <bool> selectable;
    in property <bool> checkable;
    in property <bool> enabled: true;
    in property <bool> compact;
    in property <bool> on-video;
    // Mini-guide presentation: icon above a short caption, without a tooltip.
    in property <bool> stacked;
    // Short visible caption for stacked rows; the accessible label stays complete.
    in property <string> caption: root.label;
    // Negative keeps the variant's shape; embedded segments can square it off.
    in property <length> corner-radius: -1px;
    in property <length> icon-size: root.on-video ? 24px : root.stacked ? 22px : 20px;
    // Visual emphasis is independent of selection/check state and accessibility.
    in property <ActionVariant> variant: quiet;
    private property <bool> keyboard-pressed;
    // Pointer activation focuses without a ring; keyboard focus keeps it.
    private property <bool> pointer-focus;
    private property <bool> pressed: enabled && (touch.pressed || keyboard-pressed);
    private property <bool> hovered: touch.has-hover && enabled;
    private property <color> foreground: root.on-video ? #ffffff : variant == primary ? Colors.primary-text : variant == destructive ? Colors.destructive : Colors.text;
    callback clicked;
    height: 40px;
    min-width: compact ? 40px : 70px;
    // Filled/tonal actions are pills; quiet rows keep a softer rounded rectangle.
    border-radius: root.corner-radius >= 0px ? root.corner-radius : root.on-video || (root.compact && !root.stacked && root.variant == quiet) || root.variant != quiet ? self.height / 2 : 10px;
    background: root.on-video ? (pressed ? #ffffff38 : hovered ? #ffffff24 : selected ? #ffffff18 : transparent)
        : variant == primary ? (pressed ? Colors.primary-pressed : hovered ? Colors.primary-hover : Colors.primary)
        : variant == quiet ? (pressed ? Colors.strong : hovered ? (selected ? Colors.pressed : Colors.hover) : selected ? Colors.selected : transparent)
        : pressed ? Colors.strong : hovered || selected ? Colors.pressed : Colors.hover;
    border-width: focus.has-focus && !root.pointer-focus ? 2px : 0px;
    border-color: Colors.focus;
    opacity: enabled ? 1 : 0.4;
    accessible-role: button;
    accessible-label: label;
    accessible-enabled: enabled;
    accessible-item-selectable: selectable;
    accessible-item-selected: selected;
    accessible-checkable: checkable;
    accessible-checked: selected;
    accessible-action-default => { if root.enabled { root.clicked(); } }
    forward-focus: focus;
    changed enabled => { if !root.enabled { root.keyboard-pressed = false; } }
    focus := FocusScope {
        enabled: root.enabled;
        focus-lost => { root.keyboard-pressed = false; root.pointer-focus = false; }
        key-pressed(event) => {
            if event.text == " " || event.text == Key.Return {
                // A held key is one activation, just like a held pointer.
                if !root.keyboard-pressed { root.keyboard-pressed = true; root.clicked(); }
                return accept;
            }
            return reject;
        }
        key-released(event) => {
            if event.text == " " || event.text == Key.Return { root.keyboard-pressed = false; return accept; }
            return reject;
        }
    }
    if root.icon-name != "": Image {
        source: root.icon-name == "minus" ? @image-url("icons/minus.svg")
            : root.icon-name == "x" ? @image-url("icons/x.svg")
            : root.icon-name == "square" ? @image-url("icons/square.svg")
            : root.icon-name == "copy" ? @image-url("icons/copy.svg")
            : root.icon-name == "menu" ? @image-url("icons/menu.svg")
            : root.icon-name == "house" ? @image-url("icons/house.svg")
            : root.icon-name == "library-big" ? @image-url("icons/library-big.svg")
            : root.icon-name == "users" ? @image-url("icons/users.svg")
            : root.icon-name == "list-video" ? @image-url("icons/list-video.svg")
            : root.icon-name == "refresh-cw" ? @image-url("icons/refresh-cw.svg")
            : root.icon-name == "history" ? @image-url("icons/rotate-ccw-clock.svg")
            : root.icon-name == "play" ? @image-url("icons/play.svg")
            : root.icon-name == "pause" ? @image-url("icons/pause.svg")
            : root.icon-name == "circle-user-round" ? @image-url("icons/circle-user-round.svg")
            : root.icon-name == "settings" ? @image-url("icons/settings.svg")
            : root.icon-name == "search" ? @image-url("icons/search.svg")
            : root.icon-name == "plus" ? @image-url("icons/plus.svg")
            : root.icon-name == "captions" ? @image-url("icons/captions.svg")
            : root.icon-name == "picture-in-picture-2" ? @image-url("icons/picture-in-picture-2.svg")
            : root.icon-name == "rectangle-horizontal" ? @image-url("icons/rectangle-horizontal.svg")
            : root.icon-name == "maximize" ? @image-url("icons/maximize.svg")
            : root.icon-name == "volume-2" ? @image-url("icons/volume-2.svg")
            : root.icon-name == "volume-x" ? @image-url("icons/volume-x.svg")
            : root.icon-name == "info" ? @image-url("icons/info.svg")
            : root.icon-name == "ellipsis" ? @image-url("icons/ellipsis.svg")
            : root.icon-name == "clapperboard" ? @image-url("icons/clapperboard.svg")
            : root.icon-name == "image-off" ? @image-url("icons/image-off.svg")
            : root.icon-name == "music" ? @image-url("icons/music.svg")
            : root.icon-name == "gamepad-2" ? @image-url("icons/gamepad-2.svg")
            : root.icon-name == "newspaper" ? @image-url("icons/newspaper.svg")
            : root.icon-name == "trophy" ? @image-url("icons/trophy.svg")
            : root.icon-name == "graduation-cap" ? @image-url("icons/graduation-cap.svg")
            : root.icon-name == "chevron-left" ? @image-url("icons/chevron-left.svg") : @image-url("icons/chevron-right.svg");
        colorize: root.variant == quiet && root.selected && !root.on-video ? Colors.accent : root.foreground;
        x: root.compact ? (root.width - root.icon-size) / 2 : root.variant == quiet ? 14px : 12px;
        y: root.stacked ? 12px : (root.height - root.icon-size) / 2; width: root.icon-size; height: root.icon-size;
    }
    if !root.compact: Text {
        x: root.icon-name != "" ? (root.variant == quiet ? 50px : 40px) : root.variant == quiet ? 14px : 16px; y: 0;
        width: parent.width - self.x - (root.variant == quiet ? 12px : 16px); height: parent.height;
        text: root.label; color: root.foreground; font-size: 14px;
        font-weight: root.variant != quiet || root.selected ? 600 : 400;
        horizontal-alignment: root.variant == quiet || root.icon-name != "" ? left : center;
        vertical-alignment: center; overflow: elide;
    }
    if root.compact && root.stacked: Text {
        x: 2px; y: 38px; width: parent.width - 4px; height: 16px;
        text: root.caption; color: root.foreground; font-size: 10px;
        font-weight: root.selected ? 600 : 400;
        horizontal-alignment: center; vertical-alignment: center; overflow: elide;
    }
    touch := TouchArea { enabled: root.enabled; mouse-cursor: root.enabled ? pointer : default; clicked => { root.pointer-focus = true; focus.focus(); root.clicked(); } }
    if root.compact && !root.stacked: Tooltip {
        Rectangle {
            width: tip.preferred-width + 16px; height: 30px;
            background: #3a3a3aef; border-radius: 6px;
            tip := Text { text: root.label; color: #ffffff; x: 8px; height: parent.height; vertical-alignment: center; font-size: 12px; }
        }
    }
}
export struct AccountRow { title: string, detail: string, action: string, can-account-play: bool }
export struct VideoRow { kind: string, title: string, channel: string, id: string, duration: string, thumbnail: image, thumbnail-ready: bool }
export struct VideoGroup { items: [VideoRow], start: int }
export global CatalogKeys {
    public pure function command(event: KeyEvent) -> int {
        if event.modifiers.control || event.modifiers.alt || event.modifiers.meta { return -1; }
        if event.text == Key.Tab { return event.modifiers.shift ? 0 : 1; }
        if event.text == Key.Backtab { return 0; }
        if event.text == Key.UpArrow { return 2; }
        if event.text == Key.DownArrow { return 3; }
        if event.text == Key.Home { return 4; }
        if event.text == Key.End { return 5; }
        if event.text == Key.PageUp { return 6; }
        if event.text == Key.PageDown { return 7; }
        if event.text == Key.LeftArrow { return 8; }
        if event.text == Key.RightArrow { return 9; }
        return -1;
    }
}
export component VideoCard inherits Rectangle {
    in property <bool> enabled: true;
    in property <VideoRow> item;
    in property <bool> show-channel: true;
    in property <bool> compact;
    in property <int> focus-request;
    in property <int> focus-delivery;
    callback keyboard-move(int) -> bool;
    callback card-focus(bool);
    callback claim-focus(int) -> bool;
    callback focus-ready(int);
    callback focus-complete(int, bool);
    function try-requested-focus() {
        if root.focus-request > 0 && root.focus-delivery == root.focus-request {
            let serial = root.focus-request;
            if root.claim-focus(serial) {
                focus.focus();
                root.focus-complete(serial, focus.has-focus);
            }
        }
    }
    // Data is available during init, but outer ListView row geometry is not.
    init => { if root.focus-request > 0 { root.focus-ready(root.focus-request); } }
    changed focus-request => { if root.focus-request > 0 { root.focus-ready(root.focus-request); } }
    changed focus-delivery => { root.try-requested-focus(); }
    callback clicked;
    private property <bool> channel: root.item.kind == "Channel";
    border-radius: root.compact ? 10px : 14px;
    background: transparent;
    private property <bool> pointer-focus;
    border-width: focus.has-focus && !root.pointer-focus ? 2px : 0px;
    border-color: Colors.focus;
    accessible-role: button;
    accessible-enabled: root.enabled;
    accessible-label: item.kind + ", " + item.title + ", " + item.channel;
    accessible-action-default => { if root.enabled { root.clicked(); } }
    forward-focus: focus;
    focus := FocusScope {
        enabled: root.enabled;
        focus-gained => { root.card-focus(true); }
        focus-lost => { root.pointer-focus = false; root.card-focus(false); }
        key-pressed(event) => {
            let command = CatalogKeys.command(event);
            if command >= 0 && root.keyboard-move(command) { return accept; }
            if event.text == " " || event.text == Key.Return { root.clicked(); return accept; }
            return reject;
        }
    }
    preview := Rectangle {
        x: 0; y: 0;
        width: root.compact ? 160px : parent.width;
        height: self.width * 9 / 16;
        // Channels read as a round avatar on the canvas, like a creator profile.
        background: root.channel ? transparent : Colors.raised;
        border-radius: root.compact ? 8px : 12px;
        clip: true;
        if !root.channel && root.item.thumbnail-ready: Image { source: root.item.thumbnail; width: parent.width; height: parent.height; image-fit: cover; }
        if root.channel: Rectangle {
            width: parent.height * 0.78; height: self.width;
            x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
            border-radius: self.width / 2; clip: true; background: Colors.raised;
            if root.item.thumbnail-ready: Image { source: root.item.thumbnail; width: parent.width; height: parent.height; image-fit: cover; }
            if !root.item.thumbnail-ready: Image { x: (parent.width - 36px) / 2; y: (parent.height - 36px) / 2; width: 36px; height: 36px; source: @image-url("icons/circle-user-round.svg"); colorize: Colors.muted; }
        }
        if !root.channel && !root.item.thumbnail-ready: Image { x: (parent.width - 28px) / 2; y: (parent.height - 28px) / 2; width: 28px; height: 28px; source: root.item.kind == "Playlist" ? @image-url("icons/library-big.svg") : @image-url("icons/image-off.svg"); colorize: Colors.muted; }
        if root.item.kind == "Playlist": Rectangle {
            x: parent.width - self.width - 8px; y: parent.height - self.height - 8px;
            height: 22px; width: kind-label.preferred-width + 35px;
            border-radius: 5px; background: #000000b3;
            Image { x: 7px; y: (parent.height - self.height) / 2; width: 13px; height: 13px; source: @image-url("icons/list-video.svg"); colorize: #ffffff; }
            kind-label := Text { x: 24px; height: parent.height; text: root.item.kind; color: #ffffff; font-size: 12px; font-weight: 600; vertical-alignment: center; }
        }
        if root.item.duration != "": Rectangle {
            x: parent.width - self.width - (root.compact ? 5px : 8px); y: parent.height - self.height - (root.compact ? 5px : 8px);
            width: length-label.preferred-width + 10px; height: 20px; border-radius: 5px; background: #000000b3;
            length-label := Text { text: root.item.duration; font-size: 12px; font-weight: 600; color: #ffffff; horizontal-alignment: center; vertical-alignment: center; }
        }
    }
    title := Text {
        x: root.compact ? 172px : 4px; y: root.compact ? 0px : preview.height + 12px;
        width: parent.width - self.x - 8px;
        // Up to two lines; the channel line follows the actual title height.
        height: min(self.preferred-height, root.compact ? 38px : 44px);
        text: root.item.title; color: Colors.text;
        font-size: root.compact ? 14px : 15px; font-weight: 600;
        horizontal-alignment: root.channel && !root.compact ? center : left;
        wrap: word-wrap; overflow: elide;
    }
    if root.show-channel: Text {
        x: title.x; y: title.y + title.height + (root.compact ? 4px : 6px);
        width: title.width; height: 18px;
        text: root.item.channel; color: Colors.muted; font-size: root.compact ? 12px : 13px;
        horizontal-alignment: root.channel && !root.compact ? center : left; overflow: elide;
    }
    touch := TouchArea { enabled: root.enabled; mouse-cursor: root.enabled ? pointer : default; clicked => { root.pointer-focus = true; focus.focus(); root.clicked(); } }
}
