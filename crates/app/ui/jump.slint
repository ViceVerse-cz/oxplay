import { LineEdit } from "std-widgets.slint";
import { Colors, Action, ActionVariant } from "components.slint";
export global JumpUi {
    in property <bool> available;
    in-out property <string> draft;
    in property <string> status;
    callback begin() -> bool;
    callback cancel();
    callback submit(string) -> bool;
}
export component JumpDialog inherits Rectangle {
    callback dismissed();
    forward-focus: time-input;
    background: Colors.dialog;
    border-radius: 16px;
    VerticalLayout {
        padding: 20px; spacing: 12px;
        Text { text: "Jump to time"; color: Colors.text; font-size: 20px; font-weight: 600; height: 28px; }
        time-input := LineEdit {
            text <=> JumpUi.draft;
            accessible-label: "Playback time in seconds or hours, minutes and seconds";
            height: 38px;
            changed has-focus => { if self.has-focus { self.select-all(); } }
            accepted => { if JumpUi.submit(self.text) { root.dismissed(); } }
        }
        Text { text: JumpUi.status; color: Colors.muted; wrap: word-wrap; font-size: 12px; }
        HorizontalLayout {
            Action { label: "Jump"; variant: ActionVariant.primary; enabled: JumpUi.available; clicked => { if JumpUi.submit(JumpUi.draft) { root.dismissed(); } } }
            Action { label: "Cancel"; clicked => { root.dismissed(); } }
        }
    }
}
