            function cancel() {
                if LibraryUi.busy { return; }
                page-focus.focus();
                LibraryUi.cancel-organization();
            }
            FocusScope {
                width: parent.width; height: parent.height;
                focus-on-tab-navigation: false; focus-on-click: false;
                enabled: organizer.visible;
                key-pressed(event) => { if event.text == Key.Escape { organizer.cancel(); return accept; } return reject; }
                organizer-layout := VerticalLayout { spacing: 8px; alignment: start;
                    Text { text: LibraryUi.organization == 1 ? "Duplicate “" + LibraryUi.organization-source + "”" : "Copy or move “" + LibraryUi.organization-video + "”"; color: Colors.text; wrap: word-wrap; min-height: 28px; font-weight: 600; }
                    Text { text: LibraryUi.organization == 1 ? "Creates a separate local playlist containing the same saved entries. The original stays unchanged." : "From local playlist “" + LibraryUi.organization-source + "”. Choose another local playlist below."; color: Colors.muted; wrap: word-wrap; min-height: 36px; }
                    duplicate-name := LineEdit {
                        visible: LibraryUi.organization == 1; height: self.visible ? 38px : 0px;
                        enabled: self.visible; read-only: LibraryUi.busy;
                        text <=> LibraryUi.organization-name;
                        accessible-label: "Name for duplicated local playlist"; placeholder-text: "New playlist name";
                        accepted => { if !LibraryUi.busy { LibraryUi.duplicate(LibraryUi.organization-name); } }
                    }
                    if LibraryUi.organization == 2: ConfirmedChoice {
                        height: 38px; model: LibraryUi.destinations; acknowledged-index: LibraryUi.destination-index;
                        accessible-label: "Destination local playlist"; enabled: !LibraryUi.busy && LibraryUi.destinations.length > 0;
                        choose(index) => { LibraryUi.choose-destination(index); }
                    }
                    if LibraryUi.organization == 2: HorizontalLayout { height: 38px; spacing: 8px;
                        Action { width: 120px; horizontal-stretch: 0; label: "Previous"; icon-name: "chevron-left"; enabled: !LibraryUi.busy && LibraryUi.destination-previous; clicked => { LibraryUi.destination-page(1); } }
                        Action { width: 100px; horizontal-stretch: 0; label: "Next"; icon-name: "chevron-right"; enabled: !LibraryUi.busy && LibraryUi.destination-next; clicked => { LibraryUi.destination-page(2); } }
                        Action { width: 84px; horizontal-stretch: 0; label: "Reload"; enabled: !LibraryUi.busy; clicked => { LibraryUi.destination-page(0); } }
                        Rectangle { horizontal-stretch: 1; }
                    }
                    if LibraryUi.organization == 2 && LibraryUi.destinations.length == 0 && !LibraryUi.busy: Text { text: "No other playlists on this page. Check another page, or cancel and create a destination playlist."; color: Colors.muted; wrap: word-wrap; min-height: 36px; }
                    if LibraryUi.organization == 2 && LibraryUi.destination-index >= 0: Text { text: "Destination: “" + LibraryUi.destinations[LibraryUi.destination-index] + "”. Move removes the entry from “" + LibraryUi.organization-source + "” after saving it there."; color: Colors.text; wrap: word-wrap; min-height: 40px; }
                    HorizontalLayout { height: 38px; spacing: 8px;
                        cancel-organization := Action { width: 90px; horizontal-stretch: 0; label: "Cancel"; enabled: organizer.visible && !LibraryUi.busy; clicked => { organizer.cancel(); } }
                        if LibraryUi.organization == 1: Action { width: 114px; horizontal-stretch: 0; label: "Duplicate"; variant: ActionVariant.primary; enabled: !LibraryUi.busy; clicked => { LibraryUi.duplicate(LibraryUi.organization-name); } }
                        if LibraryUi.organization == 2: Action { width: 80px; horizontal-stretch: 0; label: "Copy"; variant: ActionVariant.primary; enabled: !LibraryUi.busy && LibraryUi.destination-index >= 0; clicked => { LibraryUi.transfer-item(false); } }
                        if LibraryUi.organization == 2: Action { width: 80px; horizontal-stretch: 0; label: "Move"; variant: ActionVariant.secondary; enabled: !LibraryUi.busy && LibraryUi.destination-index >= 0; clicked => { LibraryUi.transfer-item(true); } }
                        Rectangle { horizontal-stretch: 1; }
                    }
                    Text { text: LibraryUi.organization-status; color: Colors.muted; wrap: word-wrap; min-height: 32px; }
                }
            }
        }
        if LibraryUi.tab == 1: Rectangle { height: root.narrow ? 82px : 40px;
            Text { x: 0; y: 0; height: 38px; width: root.narrow ? parent.width : parent.width - 244px; text: "Follow channels here without subscribing on YouTube."; color: Colors.muted; wrap: word-wrap; vertical-alignment: center; }
            Action { x: root.narrow ? 0px : parent.width - 236px; y: root.narrow ? 44px : 0px; height: 38px; width: 236px; label: "Follow playing channel"; variant: ActionVariant.secondary; enabled: !LibraryUi.busy && LibraryUi.confirmation == 0 && LibraryUi.organization == 0; clicked => { LibraryUi.follow-current(); } }
        }
        Rectangle { visible: LibraryUi.tab == 2; height: LibraryUi.tab == 2 ? (root.narrow ? 82px : 38px) : 0px;
            ConfirmedToggle { x: 0; y: 0; height: 38px; width: root.narrow ? parent.width : parent.width - 280px; text: "Keep local watch history"; acknowledged-checked: LibraryUi.history-enabled; enabled: LibraryUi.tab == 2 && !LibraryUi.busy && LibraryUi.confirmation == 0 && LibraryUi.organization == 0; choose(checked) => { LibraryUi.history(checked); } }
            ConfirmedChoice { x: root.narrow ? 0px : parent.width - 272px; y: root.narrow ? 44px : 0px; height: 38px; width: 132px; accessible-label: "Local history retention"; model: ["7 days", "30 days", "90 days"]; acknowledged-index: LibraryUi.retention == 7 ? 0 : LibraryUi.retention == 90 ? 2 : 1; enabled: LibraryUi.tab == 2 && !LibraryUi.busy && LibraryUi.confirmation == 0 && LibraryUi.organization == 0; choose(index) => { LibraryUi.set-retention(index == 0 ? 7 : index == 2 ? 90 : 30); } }
            history-clear := Action { x: root.narrow ? 140px : parent.width - 132px; y: root.narrow ? 44px : 0px; height: 38px; width: 132px; label: "Clear history"; variant: ActionVariant.destructive; enabled: LibraryUi.tab == 2 && !LibraryUi.busy && LibraryUi.confirmation == 0 && LibraryUi.organization == 0; clicked => { root.open-confirmation(2); } }
        }
        list := ListView { visible: LibraryUi.rows.length > 0; height: LibraryUi.rows.length == 0 ? 0px : min(LibraryUi.rows.length * (LibraryUi.tab == 0 ? 92px : LibraryUi.tab == 1 ? 56px : 78px), max(180px, root.height - (root.narrow ? 400px : 300px))); horizontal-scrollbar-policy: always-off;
            for item[index] in LibraryUi.rows: Rectangle { height: LibraryUi.tab == 0 ? 92px : LibraryUi.tab == 1 ? 56px : 78px;
                Action { x: 0; y: LibraryUi.tab == 1 ? 6px : 0px; height: 44px; width: parent.width - 130px; label: item.title; enabled: !LibraryUi.busy && LibraryUi.confirmation == 0 && LibraryUi.organization == 0; clicked => { LibraryUi.open(index); } }
                if LibraryUi.tab != 1: Text { x: 12px; y: 46px; height: 22px; width: parent.width - 166px; text: item.detail; color: Colors.muted; font-size: 12px; overflow: elide; }
                Action { x: parent.width - 120px; y: LibraryUi.tab == 1 ? 8px : 2px; width: 120px; label: item.action; enabled: !LibraryUi.busy && LibraryUi.confirmation == 0 && LibraryUi.organization == 0; clicked => { LibraryUi.remove(index); } }
                if LibraryUi.tab == 0: Action { x: parent.width - 144px; y: 52px; width: 144px; height: 34px; label: "Copy / Move…"; enabled: !LibraryUi.busy && LibraryUi.confirmation == 0 && LibraryUi.organization == 0; clicked => { root.organize(false, index); } }
            }
        }
        if LibraryUi.rows.length == 0: Text { text: LibraryUi.busy ? "Loading local data…" : LibraryUi.tab == 2 ? (LibraryUi.history-enabled ? (LibraryUi.previous || LibraryUi.next ? "No history on this page." : "Videos you watch will appear here.") : "History is off. Enable it above to remember videos on this device.") : LibraryUi.tab == 1 ? (LibraryUi.previous || LibraryUi.next ? "No channels on this page." : "Channels you follow locally will appear here.") : LibraryUi.active-filter != "" ? "No matching videos. Try another search or clear the filter." : LibraryUi.collections.length == 0 ? (LibraryUi.collections-previous || LibraryUi.collections-next ? "No playlists on this page. Try the previous page." : "Create a playlist, then save videos from the player.") : LibraryUi.previous || LibraryUi.next ? "No saved videos on this page." : "This playlist is empty. Save a video from the player."; color: Colors.muted; wrap: word-wrap; min-height: 46px; }
        if LibraryUi.previous || LibraryUi.next: HorizontalLayout { height: 38px; spacing: 8px;
            Action { width: 126px; horizontal-stretch: 0; label: "Previous"; icon-name: "chevron-left"; enabled: !LibraryUi.busy && LibraryUi.confirmation == 0 && LibraryUi.organization == 0 && LibraryUi.previous; clicked => { LibraryUi.page(false); } }
            Action { width: 106px; horizontal-stretch: 0; label: "Next"; icon-name: "chevron-right"; enabled: !LibraryUi.busy && LibraryUi.confirmation == 0 && LibraryUi.organization == 0 && LibraryUi.next; clicked => { LibraryUi.page(true); } }
            Rectangle { horizontal-stretch: 1; }
        }
        confirmation-controls := Rectangle {
            visible: LibraryUi.confirmation != 0;
            height: LibraryUi.confirmation != 0 ? confirm-layout.preferred-height : 0px;
            function focus-cancel() { confirmation-cancel.focus(); }
            FocusScope {
                width: parent.width; height: parent.height;
                focus-on-tab-navigation: false; focus-on-click: false;
                enabled: LibraryUi.confirmation != 0;
                key-pressed(event) => {
                    if event.text == Key.Escape { root.cancel-confirmation(); return accept; }
                    return reject;
                }
                confirm-layout := VerticalLayout { spacing: 8px; alignment: start;
                    Text { text: LibraryUi.confirmation == 1 ? "Delete “" + LibraryUi.collections[LibraryUi.selected] + "” and its saved entries?" : LibraryUi.confirmation == 2 ? "Delete all local watch history?" : "Stop playback and delete the local library, history, preferences, cached artwork and captions? Your YouTube account stays connected."; color: Colors.text; wrap: word-wrap; min-height: 44px; }
                    HorizontalLayout { height: 38px; spacing: 8px;
                        confirmation-cancel := Action {
                            width: 96px; horizontal-stretch: 0; label: "Cancel"; variant: ActionVariant.secondary;
                            enabled: LibraryUi.confirmation != 0;
                            clicked => { root.cancel-confirmation(); }
                            changed has-focus => {
                                if self.has-focus { LibraryUi.name-focus-target = 5; }
                                else if LibraryUi.name-focus-target == 5 { LibraryUi.name-focus-target = 0; }
                            }
                        }
                        Action {
                            width: 158px; horizontal-stretch: 0; label: "Confirm deletion"; variant: ActionVariant.destructive;
                            enabled: LibraryUi.confirmation != 0 && !LibraryUi.busy;
                            clicked => { root.confirm-deletion(); }
                            changed has-focus => {
                                if self.has-focus { LibraryUi.name-focus-target = 6; }
                                else if LibraryUi.name-focus-target == 6 { LibraryUi.name-focus-target = 0; }
                            }
                        }
                        Rectangle { horizontal-stretch: 1; }
                    }
                }
            }
        }
        HorizontalLayout { height: 38px;
            Action {
                width: 180px; horizontal-stretch: 0; label: "Manage library"; icon-name: "settings";
                checkable: true; selected: root.manage-open; enabled: root.actions-enabled;
                clicked => { root.manage-open = !root.manage-open; }
            }
            Rectangle { horizontal-stretch: 1; }
        }
        management := Rectangle {
            visible: root.manage-open;
            height: self.visible ? (root.narrow ? 86px : 38px) : 0px;
            Action { x: 0; width: 100px; height: 38px; label: "Import…"; variant: ActionVariant.secondary; enabled: management.visible && root.actions-enabled; clicked => { LibraryUi.transfer(0); } }
            Action { x: 108px; width: 100px; height: 38px; label: "Export…"; variant: ActionVariant.secondary; enabled: management.visible && root.actions-enabled; clicked => { LibraryUi.transfer(1); } }
            Action { x: 216px; width: 104px; height: 38px; label: "Backup…"; variant: ActionVariant.secondary; enabled: management.visible && root.actions-enabled; clicked => { LibraryUi.transfer(2); } }
            clear-local := Action { x: root.narrow ? 0px : 336px; y: root.narrow ? 48px : 0px; width: 170px; height: 38px; label: "Clear local data…"; variant: ActionVariant.destructive; enabled: management.visible && root.actions-enabled; clicked => { root.open-confirmation(3); } }
        }
        if LibraryUi.status != "" && LibraryUi.status != "Collections, follows and optional history stay on this device.": Text { text: LibraryUi.status; color: Colors.muted; wrap: word-wrap; min-height: 28px; vertical-stretch: 0; }
    }
    }
}
