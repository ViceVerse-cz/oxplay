// SPDX-License-Identifier: GPL-3.0-or-later
import { LineEdit, ListView, ScrollView } from "std-widgets.slint";
import { Colors, Action, ActionVariant, ConfirmedChoice, ConfirmedToggle } from "components.slint";
export struct LibraryRow { title: string, detail: string, action: string }
export global SaveUi {
    in property <[string]> collections;
    in property <string> video-title;
    in property <string> status;
    in property <bool> busy;
    in property <bool> saved;
    in property <bool> destinations-paged;
    callback begin() -> bool;
    callback create-and-save(string);
}
export global LibraryUi {
    in property <[LibraryRow]> rows;
    in property <[string]> collections;
    in property <int> selected: -1;
    in property <int> tab;
    in property <bool> busy;
    in property <bool> previous;
    in property <bool> next;
    in property <bool> collections-previous;
    in property <bool> collections-next;
    in property <bool> history-enabled;
    in property <int> organization;
    in property <string> organization-source;
    in property <string> organization-video;
    in-out property <string> organization-name;
    in property <string> organization-status;
    in property <[string]> destinations;
    in property <int> destination-index: -1;
    in property <bool> destination-previous;
    in property <bool> destination-next;
    in-out property <string> filter-draft;
    in property <string> active-filter;
    in-out property <string> name-draft;
    in property <bool> renaming;
    // Actual keyboard focus observation, also used by the finite UI diagnostic.
    in-out property <int> name-focus-target: 0;
    in-out property <int> collection-visible-index: -1;
    in-out property <string> collection-visible-value;
    in property <string> name-status;
    in-out property <int> confirmation: 0;
    in property <int> retention: 30;
    in property <string> status: "Collections, follows and optional history stay on this device.";
    callback change-tab(int);
    callback choose(int);
    callback page(bool);
    callback filter(string);
    callback collection-page(bool);
    callback create(string);
    callback rename(string);
    callback begin-rename() -> bool;
    callback cancel-name();
    callback name-context-opened();
    callback delete-collection();
    callback open(int);
    callback remove(int);
    callback history(bool);
    callback set-retention(int);
    callback clear-history();
    callback transfer(int);
    callback clear-local();
    callback follow-current();
    callback begin-duplicate() -> bool;
    callback begin-transfer(int) -> bool;
    callback cancel-organization();
    callback duplicate(string);
    callback destination-page(int);
    callback choose-destination(int);
    callback transfer-item(bool);
}
export component LibraryPage inherits Rectangle {
    private property <bool> narrow: root.width < 720px;
    private property <bool> manage-open;
    private property <bool> playlist-tools;
    private property <bool> actions-enabled: !LibraryUi.busy && LibraryUi.confirmation == 0 && LibraryUi.organization == 0;
    private property <length> confirmation-scroll-y;
    private property <bool> collection-visible: LibraryUi.tab == 0 && (LibraryUi.collections.length > 0 || LibraryUi.collections-previous || LibraryUi.collections-next);
    changed collection-visible => {
        if !root.collection-visible {
            LibraryUi.collection-visible-index = -1;
            LibraryUi.collection-visible-value = "";
        }
    }
    // Re-entering this conditional page must not revive a rename target from
    // another navigation context. The separate create draft is preserved.
    init => { LibraryUi.name-focus-target = 0; if !root.collection-visible { LibraryUi.collection-visible-index = -1; LibraryUi.collection-visible-value = ""; } LibraryUi.name-context-opened(); }
    forward-focus: page-focus;
    page-focus := FocusScope { focus-on-tab-navigation: false; focus-on-click: false; }
    function organize(duplicate: bool, index: int) {
        page-focus.focus();
        if (duplicate ? LibraryUi.begin-duplicate() : LibraryUi.begin-transfer(index)) {
            organizer.focus-editor();
            scroll.content-y = min(0px, -organizer.y);
        }
    }
    function open-confirmation(kind: int) {
        if LibraryUi.busy || LibraryUi.confirmation != 0 || LibraryUi.organization != 0 { return; }
        root.confirmation-scroll-y = scroll.content-y;
        // Deliver FocusOut while the old action is still enabled. The pinned
        // backend can otherwise retain its has-focus after disabling it.
        page-focus.focus();
        LibraryUi.confirmation = kind;
        confirmation-controls.focus-cancel();
        scroll.content-y = min(0px, scroll.visible-height - content.height);
    }
    function cancel-confirmation() {
        let previous = LibraryUi.confirmation;
        page-focus.focus();
        LibraryUi.confirmation = 0;
        scroll.content-y = max(min(root.confirmation-scroll-y, 0px), min(0px, scroll.visible-height - content.height));
        if previous == 1 { editor.focus-delete(); }
        else if previous == 2 { history-clear.focus(); }
        else { clear-local.focus(); }
    }
    function confirm-deletion() {
        if LibraryUi.busy || LibraryUi.confirmation == 0 || LibraryUi.organization != 0 { return; }
        let previous = LibraryUi.confirmation;
        page-focus.focus();
        LibraryUi.confirmation = 0;
        if previous == 1 { LibraryUi.delete-collection(); }
        else if previous == 2 { LibraryUi.clear-history(); }
        else { LibraryUi.clear-local(); }
    }
    scroll := ScrollView {
      width: parent.width; height: parent.height; horizontal-scrollbar-policy: always-off;
      content := VerticalLayout {
        width: parent.visible-width; spacing: 12px; alignment: start;
        // ScrollView can offer more height than the rows need. Keep every
        // section at its intrinsic/fixed height instead of distributing it.
        vertical-stretch: 0;
        Text { text: LibraryUi.tab == 1 ? "Local subscriptions" : LibraryUi.tab == 2 ? "Watch history" : "Local playlists"; color: Colors.text; font-size: 26px; font-weight: 700; height: 36px; }
        Text { text: "On this device · separate from your YouTube account"; color: Colors.muted; wrap: word-wrap; min-height: 24px; vertical-stretch: 0; }
        HorizontalLayout { height: 40px; spacing: 10px;
            Action { width: 100px; horizontal-stretch: 0; label: "Playlists"; selectable: true; selected: LibraryUi.tab == 0; enabled: !LibraryUi.busy && LibraryUi.confirmation == 0 && LibraryUi.organization == 0; clicked => { LibraryUi.change-tab(0); } }
            Action { width: 138px; horizontal-stretch: 0; label: "Subscriptions"; selectable: true; selected: LibraryUi.tab == 1; enabled: !LibraryUi.busy && LibraryUi.confirmation == 0 && LibraryUi.organization == 0; clicked => { LibraryUi.change-tab(1); } }
            if LibraryUi.history-enabled: Action { width: 138px; horizontal-stretch: 0; label: "Watch history"; selectable: true; selected: LibraryUi.tab == 2; enabled: !LibraryUi.busy && LibraryUi.confirmation == 0 && LibraryUi.organization == 0; clicked => { LibraryUi.change-tab(2); } }
            Rectangle { horizontal-stretch: 1; }
        }
        if root.collection-visible: HorizontalLayout { height: 38px; spacing: 8px; alignment: start;
            ConfirmedChoice {
                width: min(420px, parent.width - (LibraryUi.collections-previous || LibraryUi.collections-next ? 96px : 0px)); horizontal-stretch: 0; accessible-label: "Local playlist";
                model: LibraryUi.collections;
                acknowledged-index: LibraryUi.selected;
                enabled: LibraryUi.collections.length > 0 && !LibraryUi.busy && LibraryUi.confirmation == 0 && LibraryUi.organization == 0;
                init => {
                    LibraryUi.collection-visible-index = self.current-index;
                    LibraryUi.collection-visible-value = self.current-value;
                }
                changed current-index => { LibraryUi.collection-visible-index = self.current-index; }
                changed current-value => { LibraryUi.collection-visible-value = self.current-value; }
                choose(index) => { LibraryUi.choose(index); }
                changed has-focus => {
                    if self.has-focus { LibraryUi.name-focus-target = 7; }
                    else if LibraryUi.name-focus-target == 7 { LibraryUi.name-focus-target = 0; }
                }
            }
            if LibraryUi.collections-previous || LibraryUi.collections-next: Action { width: 40px; horizontal-stretch: 0; compact: true; accessible-label: "Previous playlist page"; label: "Previous playlists"; icon-name: "chevron-left"; enabled: !LibraryUi.busy && LibraryUi.confirmation == 0 && LibraryUi.organization == 0 && LibraryUi.collections-previous; clicked => { LibraryUi.collection-page(false); } }
            if LibraryUi.collections-previous || LibraryUi.collections-next: Action { width: 40px; horizontal-stretch: 0; compact: true; accessible-label: "Next playlist page"; label: "Next playlists"; icon-name: "chevron-right"; enabled: !LibraryUi.busy && LibraryUi.confirmation == 0 && LibraryUi.organization == 0 && LibraryUi.collections-next; clicked => { LibraryUi.collection-page(true); } }
        }
        if LibraryUi.tab == 0: HorizontalLayout { height: 38px; spacing: 8px;
            Action {
                width: 156px; horizontal-stretch: 0;
                label: root.playlist-tools ? "Done editing" : LibraryUi.collections.length == 0 ? "New playlist" : "Edit playlists";
                icon-name: root.playlist-tools ? "x" : "plus";
                checkable: true; selected: root.playlist-tools; enabled: root.actions-enabled;
                clicked => {
                    if root.playlist-tools {
                        page-focus.focus();
                        LibraryUi.cancel-name();
                        root.playlist-tools = false;
                    } else { root.playlist-tools = true; editor.focus-name(); }
                }
                changed has-focus => {
                    if self.has-focus { LibraryUi.name-focus-target = 8; }
                    else if LibraryUi.name-focus-target == 8 { LibraryUi.name-focus-target = 0; }
                }
            }
            if root.playlist-tools && LibraryUi.selected >= 0: Action {
                width: 172px; horizontal-stretch: 0; label: "Duplicate playlist…";
                enabled: root.actions-enabled; clicked => { root.organize(true, -1); }
            }
            Rectangle { horizontal-stretch: 1; }
        }
        // Resize these same controls instead of rebuilding an alternate toolbar.
        editor := Rectangle {
            visible: LibraryUi.tab == 0 && root.playlist-tools;
            height: self.visible ? (root.narrow ? 82px : 38px) : 0px;
            function focus-name() { name.focus(); }
            function submit-name() {
                if LibraryUi.busy || LibraryUi.confirmation != 0 || LibraryUi.tab != 0 || LibraryUi.organization != 0 { return; }
                // Retain the real TextInput across asynchronous writes/reads.
                // Disabling it would lose focus before success/error returns.
                name.focus();
                if LibraryUi.renaming { LibraryUi.rename(LibraryUi.name-draft); }
                else { LibraryUi.create(LibraryUi.name-draft); }
            }
            function cancel-name() {
                if LibraryUi.busy || LibraryUi.confirmation != 0 { return; }
                LibraryUi.cancel-name();
                name.focus();
            }
            function focus-delete() {
                if delete-name.enabled { delete-name.focus(); }
                else { name.focus(); }
            }
            name := LineEdit {
                x: 0; y: 0; width: root.narrow ? parent.width : parent.width - 304px; height: 38px;
                accessible-label: LibraryUi.renaming ? "New name for selected playlist" : "New playlist name";
                placeholder-text: LibraryUi.renaming ? "New playlist name" : "Playlist name";
                text <=> LibraryUi.name-draft;
                enabled: editor.visible && LibraryUi.confirmation == 0 && LibraryUi.organization == 0;
                read-only: LibraryUi.busy;
                accepted => { editor.submit-name(); }
                key-pressed(event) => {
                    if event.text == Key.Escape {
                        if LibraryUi.renaming { editor.cancel-name(); }
                        return accept;
                    }
                    return reject;
                }
                changed has-focus => {
                    if self.has-focus { LibraryUi.name-focus-target = 1; }
                    else if LibraryUi.name-focus-target == 1 { LibraryUi.name-focus-target = 0; }
                }
            }
            Action {
                x: root.narrow ? 0px : parent.width - 296px; y: root.narrow ? 44px : 0px; width: 88px; height: 38px;
                label: LibraryUi.renaming ? "Save" : "Create";
                accessible-label: LibraryUi.renaming ? "Save playlist name" : "Create playlist";
                variant: ActionVariant.primary;
                enabled: editor.visible && !LibraryUi.busy && LibraryUi.confirmation == 0 && LibraryUi.organization == 0;
                clicked => { editor.submit-name(); }
                changed has-focus => {
                    if self.has-focus { LibraryUi.name-focus-target = 2; }
                    else if LibraryUi.name-focus-target == 2 { LibraryUi.name-focus-target = 0; }
                }
            }
            Action {
                x: root.narrow ? 96px : parent.width - 200px; y: root.narrow ? 44px : 0px; width: 96px; height: 38px;
                label: LibraryUi.renaming ? "Cancel" : "Rename"; variant: ActionVariant.secondary;
                enabled: editor.visible && !LibraryUi.busy && LibraryUi.confirmation == 0 && LibraryUi.organization == 0 && LibraryUi.selected >= 0;
                clicked => {
                    if LibraryUi.renaming { editor.cancel-name(); }
                    else if LibraryUi.begin-rename() { name.focus(); name.select-all(); }
                }
                changed has-focus => {
                    if self.has-focus { LibraryUi.name-focus-target = 3; }
                    else if LibraryUi.name-focus-target == 3 { LibraryUi.name-focus-target = 0; }
                }
            }
            delete-name := Action {
                x: root.narrow ? 200px : parent.width - 96px; y: root.narrow ? 44px : 0px; width: 96px; height: 38px;
                label: "Delete"; variant: ActionVariant.destructive;
                enabled: editor.visible && !LibraryUi.busy && !LibraryUi.renaming && LibraryUi.confirmation == 0 && LibraryUi.organization == 0 && LibraryUi.selected >= 0;
                clicked => { root.open-confirmation(1); }
                changed has-focus => {
                    if self.has-focus { LibraryUi.name-focus-target = 4; }
                    else if LibraryUi.name-focus-target == 4 { LibraryUi.name-focus-target = 0; }
                }
            }
        }
        if editor.visible && LibraryUi.name-status != "": Text { text: LibraryUi.name-status; color: Colors.muted; wrap: word-wrap; min-height: 26px; }
        playlist-search := Rectangle {
            visible: LibraryUi.tab == 0 && LibraryUi.selected >= 0;
            height: self.visible ? 38px : 0px;
            function apply() {
                if LibraryUi.busy || LibraryUi.confirmation != 0 { return; }
                search.focus();
                LibraryUi.filter(LibraryUi.filter-draft);
            }
            search := LineEdit {
                x: 0; y: 0; width: parent.width - 160px; height: 38px;
                accessible-label: "Search saved titles and channels in this playlist";
                placeholder-text: "Search this playlist";
                text <=> LibraryUi.filter-draft;
                enabled: playlist-search.visible && LibraryUi.confirmation == 0 && LibraryUi.organization == 0;
                read-only: LibraryUi.busy;
                accepted => { playlist-search.apply(); }
            }
            Action {
                x: parent.width - 152px; width: 72px; height: 38px;
                label: "Apply"; accessible-label: "Apply playlist search";
                enabled: playlist-search.visible && !LibraryUi.busy && LibraryUi.confirmation == 0 && LibraryUi.organization == 0;
                clicked => { playlist-search.apply(); }
            }
            Action {
                x: parent.width - 72px; width: 72px; height: 38px;
                label: "Clear"; accessible-label: "Clear playlist search";
                enabled: playlist-search.visible && !LibraryUi.busy && LibraryUi.confirmation == 0 && LibraryUi.organization == 0 && (LibraryUi.active-filter != "" || LibraryUi.filter-draft != "");
                clicked => { search.focus(); LibraryUi.filter(""); }
            }
        }
        if LibraryUi.tab == 0 && LibraryUi.active-filter != "": Text { text: "Showing matches for “" + LibraryUi.active-filter + "” in saved titles and channel names."; color: Colors.muted; wrap: word-wrap; min-height: 24px; }
        organizer := Rectangle {
            visible: LibraryUi.organization != 0;
            height: self.visible ? organizer-layout.preferred-height : 0px;
            function focus-editor() {
                if LibraryUi.organization == 1 { duplicate-name.focus(); }
