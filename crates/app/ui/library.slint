// SPDX-License-Identifier: GPL-3.0-or-later
import { LineEdit, ListView, ScrollView } from "std-widgets.slint";
import { Colors, Action, ActionVariant, ConfirmedChoice, ConfirmedToggle } from "components.slint";
export struct LibraryRow { title: string, detail: string, action: string }
export global SaveUi {
    in property <[string]> collections;
    in property <string> video-title;
    in property <string> status;
    in property <bool> busy;
    in property <bool> saved;
    in property <bool> destinations-paged;
    callback begin() -> bool;
    callback create-and-save(string);
}
export global LibraryUi {
    in property <[LibraryRow]> rows;
    in property <[string]> collections;
    in property <int> selected: -1;
    in property <int> tab;
    in property <bool> busy;
    in property <bool> previous;
    in property <bool> next;
    in property <bool> collections-previous;
    in property <bool> collections-next;
    in property <bool> history-enabled;
    in-out property <string> name-draft;
    in property <bool> renaming;
    // Actual keyboard focus observation, also used by the finite UI diagnostic.
    in-out property <int> name-focus-target: 0;
    in-out property <int> collection-visible-index: -1;
    in-out property <string> collection-visible-value;
    in property <string> name-status;
    in-out property <int> confirmation: 0;
    in property <int> retention: 30;
    in property <string> status: "Collections, follows and optional history stay on this device.";
    callback change-tab(int);
    callback choose(int);
    callback page(bool);
    callback collection-page(bool);
    callback create(string);
    callback rename(string);
    callback begin-rename() -> bool;
    callback cancel-name();
    callback name-context-opened();
    callback delete-collection();
    callback open(int);
    callback remove(int);
    callback history(bool);
    callback set-retention(int);
    callback clear-history();
    callback transfer(int);
    callback clear-local();
    callback follow-current();
}
export component LibraryPage inherits Rectangle {
    private property <bool> narrow: root.width < 720px;
    private property <length> confirmation-scroll-y;
    private property <bool> collection-visible: LibraryUi.tab == 0 && LibraryUi.collections.length > 0;
    changed collection-visible => {
        if !root.collection-visible {
            LibraryUi.collection-visible-index = -1;
            LibraryUi.collection-visible-value = "";
        }
    }
    // Re-entering this conditional page must not revive a rename target from
    // another navigation context. The separate create draft is preserved.
    init => { LibraryUi.name-focus-target = 0; if !root.collection-visible { LibraryUi.collection-visible-index = -1; LibraryUi.collection-visible-value = ""; } LibraryUi.name-context-opened(); }
    forward-focus: page-focus;
    page-focus := FocusScope { focus-on-tab-navigation: false; focus-on-click: false; }
    function open-confirmation(kind: int) {
        if LibraryUi.busy || LibraryUi.confirmation != 0 { return; }
        root.confirmation-scroll-y = scroll.content-y;
        // Deliver FocusOut while the old action is still enabled. The pinned
        // backend can otherwise retain its has-focus after disabling it.
        page-focus.focus();
        LibraryUi.confirmation = kind;
        confirmation-controls.focus-cancel();
        scroll.content-y = min(0px, scroll.visible-height - content.height);
    }
    function cancel-confirmation() {
        let previous = LibraryUi.confirmation;
        page-focus.focus();
        LibraryUi.confirmation = 0;
        scroll.content-y = max(min(root.confirmation-scroll-y, 0px), min(0px, scroll.visible-height - content.height));
        if previous == 1 { editor.focus-delete(); }
        else if previous == 2 { history-clear.focus(); }
        else { clear-local.focus(); }
    }
    function confirm-deletion() {
        if LibraryUi.busy || LibraryUi.confirmation == 0 { return; }
        let previous = LibraryUi.confirmation;
        page-focus.focus();
        LibraryUi.confirmation = 0;
        if previous == 1 { LibraryUi.delete-collection(); }
        else if previous == 2 { LibraryUi.clear-history(); }
        else { LibraryUi.clear-local(); }
    }
    scroll := ScrollView {
      width: parent.width; height: parent.height; horizontal-scrollbar-policy: always-off;
      content := VerticalLayout {
        width: parent.visible-width; spacing: 12px;
        Text { text: LibraryUi.tab == 1 ? "Local subscriptions" : LibraryUi.tab == 2 ? "Watch history" : "Local playlists"; color: Colors.text; font-size: 26px; font-weight: 700; height: 36px; }
        Text { text: "Saved on this device. Separate from your YouTube account."; color: Colors.muted; wrap: word-wrap; min-height: 24px; }
        HorizontalLayout { height: 40px; spacing: 10px;
            Action { label: "Playlists"; selectable: true; selected: LibraryUi.tab == 0; enabled: !LibraryUi.busy && LibraryUi.confirmation == 0; clicked => { LibraryUi.change-tab(0); } }
            Action { label: "Subscriptions"; selectable: true; selected: LibraryUi.tab == 1; enabled: !LibraryUi.busy && LibraryUi.confirmation == 0; clicked => { LibraryUi.change-tab(1); } }
            if LibraryUi.history-enabled: Action { label: "Watch history"; selectable: true; selected: LibraryUi.tab == 2; enabled: !LibraryUi.busy && LibraryUi.confirmation == 0; clicked => { LibraryUi.change-tab(2); } }
            Rectangle { horizontal-stretch: 1; }
        }
        if root.collection-visible: HorizontalLayout { height: 38px; spacing: 8px;
            ConfirmedChoice {
                horizontal-stretch: 1; accessible-label: "Local playlist";
                model: LibraryUi.collections;
                acknowledged-index: LibraryUi.selected;
                enabled: !LibraryUi.busy && LibraryUi.confirmation == 0;
                init => {
                    LibraryUi.collection-visible-index = self.current-index;
                    LibraryUi.collection-visible-value = self.current-value;
                }
                changed current-index => { LibraryUi.collection-visible-index = self.current-index; }
                changed current-value => { LibraryUi.collection-visible-value = self.current-value; }
                choose(index) => { LibraryUi.choose(index); }
                changed has-focus => {
                    if self.has-focus { LibraryUi.name-focus-target = 7; }
                    else if LibraryUi.name-focus-target == 7 { LibraryUi.name-focus-target = 0; }
                }
            }
            if LibraryUi.collections-previous || LibraryUi.collections-next: Action { width: 40px; horizontal-stretch: 0; compact: true; accessible-label: "Previous playlist page"; label: "Previous playlists"; icon-name: "chevron-left"; enabled: !LibraryUi.busy && LibraryUi.confirmation == 0 && LibraryUi.collections-previous; clicked => { LibraryUi.collection-page(false); } }
            if LibraryUi.collections-previous || LibraryUi.collections-next: Action { width: 40px; horizontal-stretch: 0; compact: true; accessible-label: "Next playlist page"; label: "Next playlists"; icon-name: "chevron-right"; enabled: !LibraryUi.busy && LibraryUi.confirmation == 0 && LibraryUi.collections-next; clicked => { LibraryUi.collection-page(true); } }
        }
        // Resize these same controls instead of rebuilding an alternate toolbar.
        editor := Rectangle {
            visible: LibraryUi.tab == 0;
            height: LibraryUi.tab == 0 ? (root.narrow ? 82px : 38px) : 0px;
            function submit-name() {
                if LibraryUi.busy || LibraryUi.confirmation != 0 || LibraryUi.tab != 0 { return; }
                // Retain the real TextInput across asynchronous writes/reads.
                // Disabling it would lose focus before success/error returns.
                name.focus();
                if LibraryUi.renaming { LibraryUi.rename(LibraryUi.name-draft); }
                else { LibraryUi.create(LibraryUi.name-draft); }
            }
            function cancel-name() {
                if LibraryUi.busy || LibraryUi.confirmation != 0 { return; }
                LibraryUi.cancel-name();
                name.focus();
            }
            function focus-delete() {
                if delete-name.enabled { delete-name.focus(); }
                else { name.focus(); }
            }
            name := LineEdit {
                x: 0; y: 0; width: root.narrow ? parent.width : parent.width - 304px; height: 38px;
                accessible-label: LibraryUi.renaming ? "New name for selected playlist" : "New playlist name";
                placeholder-text: LibraryUi.renaming ? "New playlist name" : "Playlist name";
                text <=> LibraryUi.name-draft;
                enabled: LibraryUi.tab == 0 && LibraryUi.confirmation == 0;
                read-only: LibraryUi.busy;
                accepted => { editor.submit-name(); }
                key-pressed(event) => {
                    if event.text == Key.Escape {
                        if LibraryUi.renaming { editor.cancel-name(); }
                        return accept;
                    }
                    return reject;
                }
                changed has-focus => {
                    if self.has-focus { LibraryUi.name-focus-target = 1; }
                    else if LibraryUi.name-focus-target == 1 { LibraryUi.name-focus-target = 0; }
                }
            }
            Action {
                x: root.narrow ? 0px : parent.width - 296px; y: root.narrow ? 44px : 0px; width: 88px; height: 38px;
                label: LibraryUi.renaming ? "Save" : "Create";
                accessible-label: LibraryUi.renaming ? "Save playlist name" : "Create playlist";
                variant: ActionVariant.primary;
                enabled: LibraryUi.tab == 0 && !LibraryUi.busy && LibraryUi.confirmation == 0;
                clicked => { editor.submit-name(); }
                changed has-focus => {
                    if self.has-focus { LibraryUi.name-focus-target = 2; }
                    else if LibraryUi.name-focus-target == 2 { LibraryUi.name-focus-target = 0; }
                }
            }
            Action {
                x: root.narrow ? 96px : parent.width - 200px; y: root.narrow ? 44px : 0px; width: 96px; height: 38px;
                label: LibraryUi.renaming ? "Cancel" : "Rename"; variant: ActionVariant.secondary;
                enabled: LibraryUi.tab == 0 && !LibraryUi.busy && LibraryUi.confirmation == 0 && LibraryUi.selected >= 0;
                clicked => {
                    if LibraryUi.renaming { editor.cancel-name(); }
                    else if LibraryUi.begin-rename() { name.focus(); name.select-all(); }
                }
                changed has-focus => {
                    if self.has-focus { LibraryUi.name-focus-target = 3; }
                    else if LibraryUi.name-focus-target == 3 { LibraryUi.name-focus-target = 0; }
                }
            }
            delete-name := Action {
                x: root.narrow ? 200px : parent.width - 96px; y: root.narrow ? 44px : 0px; width: 96px; height: 38px;
                label: "Delete"; variant: ActionVariant.destructive;
                enabled: LibraryUi.tab == 0 && !LibraryUi.busy && !LibraryUi.renaming && LibraryUi.confirmation == 0 && LibraryUi.selected >= 0;
                clicked => { root.open-confirmation(1); }
                changed has-focus => {
                    if self.has-focus { LibraryUi.name-focus-target = 4; }
                    else if LibraryUi.name-focus-target == 4 { LibraryUi.name-focus-target = 0; }
                }
            }
        }
        if LibraryUi.tab == 0 && LibraryUi.name-status != "": Text { text: LibraryUi.name-status; color: Colors.muted; wrap: word-wrap; min-height: 26px; }
        if LibraryUi.tab == 1: Rectangle { height: root.narrow ? 82px : 40px;
            Text { x: 0; y: 0; height: 38px; width: root.narrow ? parent.width : parent.width - 244px; text: "Local follows do not subscribe on YouTube."; color: Colors.muted; wrap: word-wrap; vertical-alignment: center; }
            Action { x: root.narrow ? 0px : parent.width - 236px; y: root.narrow ? 44px : 0px; height: 38px; width: 236px; label: "Follow playing channel locally"; variant: ActionVariant.secondary; enabled: !LibraryUi.busy && LibraryUi.confirmation == 0; clicked => { LibraryUi.follow-current(); } }
        }
        Rectangle { visible: LibraryUi.tab == 2; height: LibraryUi.tab == 2 ? (root.narrow ? 82px : 38px) : 0px;
            ConfirmedToggle { x: 0; y: 0; height: 38px; width: root.narrow ? parent.width : parent.width - 280px; text: "Keep local watch history"; acknowledged-checked: LibraryUi.history-enabled; enabled: LibraryUi.tab == 2 && !LibraryUi.busy && LibraryUi.confirmation == 0; choose(checked) => { LibraryUi.history(checked); } }
            ConfirmedChoice { x: root.narrow ? 0px : parent.width - 272px; y: root.narrow ? 44px : 0px; height: 38px; width: 132px; accessible-label: "Local history retention"; model: ["7 days", "30 days", "90 days"]; acknowledged-index: LibraryUi.retention == 7 ? 0 : LibraryUi.retention == 90 ? 2 : 1; enabled: LibraryUi.tab == 2 && !LibraryUi.busy && LibraryUi.confirmation == 0; choose(index) => { LibraryUi.set-retention(index == 0 ? 7 : index == 2 ? 90 : 30); } }
            history-clear := Action { x: root.narrow ? 140px : parent.width - 132px; y: root.narrow ? 44px : 0px; height: 38px; width: 132px; label: "Clear history"; variant: ActionVariant.destructive; enabled: LibraryUi.tab == 2 && !LibraryUi.busy && LibraryUi.confirmation == 0; clicked => { root.open-confirmation(2); } }
        }
        list := ListView { visible: LibraryUi.rows.length > 0; height: LibraryUi.rows.length == 0 ? 0px : max(180px, root.height - (root.narrow ? 430px : 386px)); horizontal-scrollbar-policy: always-off;
            for item[index] in LibraryUi.rows: Rectangle { height: 78px;
                Action { x: 0; y: 0; height: 44px; width: parent.width - 130px; label: item.title; enabled: !LibraryUi.busy && LibraryUi.confirmation == 0; clicked => { LibraryUi.open(index); } }
                Text { x: 12px; y: 46px; height: 22px; width: parent.width - 142px; text: item.detail; color: Colors.muted; font-size: 12px; overflow: elide; }
                Action { x: parent.width - 120px; y: 16px; width: 120px; label: item.action; enabled: !LibraryUi.busy && LibraryUi.confirmation == 0; clicked => { LibraryUi.remove(index); } }
            }
        }
        if LibraryUi.rows.length == 0: Text { text: LibraryUi.busy ? "Loading local data…" : LibraryUi.tab == 2 ? "No local history on this page. Recording starts only after you enable it." : LibraryUi.tab == 1 ? "No local subscriptions on this page. Follow a public channel to keep it here." : LibraryUi.collections.length == 0 ? "Create a playlist to keep videos on this device." : "No saved videos on this page. Save a video from the player."; color: Colors.muted; wrap: word-wrap; min-height: 46px; }
        if LibraryUi.previous || LibraryUi.next: HorizontalLayout { height: 38px; spacing: 8px;
            Action { width: 126px; horizontal-stretch: 0; label: "Previous"; icon-name: "chevron-left"; enabled: !LibraryUi.busy && LibraryUi.confirmation == 0 && LibraryUi.previous; clicked => { LibraryUi.page(false); } }
            Action { width: 106px; horizontal-stretch: 0; label: "Next"; icon-name: "chevron-right"; enabled: !LibraryUi.busy && LibraryUi.confirmation == 0 && LibraryUi.next; clicked => { LibraryUi.page(true); } }
            Rectangle { horizontal-stretch: 1; }
        }
        confirmation-controls := Rectangle {
            visible: LibraryUi.confirmation != 0;
            height: LibraryUi.confirmation != 0 ? confirm-layout.preferred-height : 0px;
            function focus-cancel() { confirmation-cancel.focus(); }
            FocusScope {
                width: parent.width; height: parent.height;
                focus-on-tab-navigation: false; focus-on-click: false;
                enabled: LibraryUi.confirmation != 0;
                key-pressed(event) => {
                    if event.text == Key.Escape { root.cancel-confirmation(); return accept; }
                    return reject;
                }
                confirm-layout := VerticalLayout { spacing: 8px;
                    Text { text: LibraryUi.confirmation == 1 ? "Delete “" + LibraryUi.collections[LibraryUi.selected] + "” and its saved entries?" : LibraryUi.confirmation == 2 ? "Delete all local watch history?" : "Stop playback and delete the local library, history, preferences, cached artwork and captions? Your YouTube account stays connected."; color: Colors.text; wrap: word-wrap; min-height: 44px; }
                    HorizontalLayout { height: 38px; spacing: 8px;
                        confirmation-cancel := Action {
                            width: 96px; horizontal-stretch: 0; label: "Cancel"; variant: ActionVariant.secondary;
                            enabled: LibraryUi.confirmation != 0;
                            clicked => { root.cancel-confirmation(); }
                            changed has-focus => {
                                if self.has-focus { LibraryUi.name-focus-target = 5; }
                                else if LibraryUi.name-focus-target == 5 { LibraryUi.name-focus-target = 0; }
                            }
                        }
                        Action {
                            width: 158px; horizontal-stretch: 0; label: "Confirm deletion"; variant: ActionVariant.destructive;
                            enabled: LibraryUi.confirmation != 0 && !LibraryUi.busy;
                            clicked => { root.confirm-deletion(); }
                            changed has-focus => {
                                if self.has-focus { LibraryUi.name-focus-target = 6; }
                                else if LibraryUi.name-focus-target == 6 { LibraryUi.name-focus-target = 0; }
                            }
                        }
                        Rectangle { horizontal-stretch: 1; }
                    }
                }
            }
        }
        HorizontalLayout { height: 38px; spacing: 8px;
            Action { label: "Import…"; variant: ActionVariant.secondary; enabled: !LibraryUi.busy && LibraryUi.confirmation == 0; clicked => { LibraryUi.transfer(0); } }
            Action { label: "Export…"; variant: ActionVariant.secondary; enabled: !LibraryUi.busy && LibraryUi.confirmation == 0; clicked => { LibraryUi.transfer(1); } }
            Action { label: "Backup…"; variant: ActionVariant.secondary; enabled: !LibraryUi.busy && LibraryUi.confirmation == 0; clicked => { LibraryUi.transfer(2); } }
            clear-local := Action { label: "Clear local data…"; variant: ActionVariant.destructive; enabled: !LibraryUi.busy && LibraryUi.confirmation == 0; clicked => { root.open-confirmation(3); } }
        }
        Text { text: LibraryUi.status; color: Colors.muted; wrap: word-wrap; min-height: 38px; }
    }
    }
}
