import { Colors, Action } from "components.slint";
export component SearchField inherits Rectangle {
    in-out property <string> text;
    in property <string> placeholder: "Search YouTube";
    in property <bool> enabled: true;
    out property <bool> has-focus: input.has-focus;
    callback accepted(string);
    callback edited();
    forward-focus: input;
    height: 40px;
    border-radius: self.height / 2;
    border-width: 1px;
    border-color: input.has-focus ? Colors.focus : Colors.border;
    background: Colors.dark ? #121212 : #ffffff;
    clip: true;
    private property <length> button-width: 64px;
    // A leading glass appears while typing, as a quiet cue that Enter searches.
    private property <length> text-x: input.has-focus ? 44px : 18px;
    if input.has-focus: Image {
        x: 16px; y: (parent.height - self.height) / 2; width: 18px; height: 18px;
        source: @image-url("icons/search.svg"); colorize: Colors.muted;
    }
    if root.text == "": Text {
        x: root.text-x; height: parent.height; width: parent.width - self.x - root.button-width - 12px;
        text: root.placeholder; color: Colors.muted;
        vertical-alignment: center; overflow: elide;
    }
    input := TextInput {
        x: root.text-x; width: max(0px, parent.width - self.x - root.button-width - 12px); height: parent.height;
        enabled: root.enabled; single-line: true;
        text <=> root.text;
        color: Colors.text; vertical-alignment: center;
        selection-background-color: Colors.focus;
        selection-foreground-color: #ffffff;
        accessible-label: "Search YouTube";
        edited => { root.edited(); }
        accepted => { root.accepted(root.text); }
    }
    Rectangle {
        x: parent.width - root.button-width; y: 0px; width: root.button-width; height: parent.height;
        background: Colors.dark ? #222222 : #f8f8f8;
        Rectangle { x: 0px; width: 1px; height: parent.height; background: Colors.border; }
        Action {
            x: 1px; y: 0px; width: parent.width - 1px; height: parent.height;
            compact: true; corner-radius: 0px; icon-name: "search"; label: "Search";
            enabled: root.enabled;
            clicked => { root.accepted(root.text); }
        }
    }
}
