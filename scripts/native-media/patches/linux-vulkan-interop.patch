+static bool map_hwdec(struct libmpv_gpu_next_context *ctx, struct pl_frame *frame,
+                      struct mp_image *image)
+{
+    struct priv *p = ctx->priv;
+    reap(ctx);
+    if (p->failed || p->num_maps >= MAX_NATIVE_MAPPINGS)
+        return false;
+    AVFrame *avframe = mp_image_to_av_frame(image);
+    if (!avframe)
+        return false;
+    struct mapping *m = talloc_zero(p, struct mapping);
+    // VAAPI -> DRM_PRIME uses AV_HWFRAME_MAP_DIRECT; there is no CPU fallback.
+    bool ok = pl_map_avframe_ex(ctx->gpu, &m->mapped,
+                                pl_avframe_params(.frame = avframe));
+    av_frame_free(&avframe);
+    if (!ok) {
+        talloc_free(m);
+        return false;
+    }
+    frame->num_planes = m->mapped.num_planes;
+    for (int i = 0; i < frame->num_planes; i++)
+        frame->planes[i] = m->mapped.planes[i];
+    frame->repr.bits = m->mapped.repr.bits;
+    frame->user_data = m;
+    m->next = p->maps;
+    p->maps = m;
+    p->num_maps++;
+    return true;
+}
+static void hold_hwdec(struct libmpv_gpu_next_context *ctx, struct pl_frame *frame)
+{
+    struct priv *p = ctx->priv;
+    // Common hook also sees software frames: never dereference their user_data.
+    for (struct mapping *m = p->maps; m; m = m->next) {
+        if (frame->user_data == m) {
+            m->completion = p->current.signal_semaphore;
+            m->value = p->current.signal_value;
+            break;
+        }
+    }
+}
+static void unmap_hwdec(struct libmpv_gpu_next_context *ctx, struct pl_frame *frame)
+{
+    struct mapping *m = frame->user_data;
+    m->retired = true;
+    reap(ctx); // Keep decoder AVFrame + DMA_BUF alive until the GPU fence fires.
+}
