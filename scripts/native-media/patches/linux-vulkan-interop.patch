+static int init_hwdec(struct libmpv_gpu_next_context *ctx,
+                      struct mp_hwdec_devices *devices)
+{
+    struct priv *p = ctx->priv;
+    // Software decoding remains available if no matching VAAPI adapter exists.
+    if (!p->drm_node || !pl_test_pixfmt(ctx->gpu, AV_PIX_FMT_VAAPI))
+        return 0;
+    struct stat node;
+    if (stat(p->drm_node, &node) || !S_ISCHR(node.st_mode))
+        return MPV_ERROR_INVALID_PARAMETER;
+    VkPhysicalDeviceDrmPropertiesEXT drm = {
+        .sType = VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_DRM_PROPERTIES_EXT};
+    VkPhysicalDeviceProperties2 props = {
+        .sType = VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_PROPERTIES_2, .pNext = &drm};
+    p->properties(p->physical, &props);
+    if (!drm.hasRender || major(node.st_rdev) != drm.renderMajor ||
+        minor(node.st_rdev) != drm.renderMinor) {
+        MP_ERR(ctx, "VAAPI render node does not match the Vulkan adapter.\n");
+        return MPV_ERROR_INVALID_PARAMETER;
+    }
+    if (av_hwdevice_ctx_create(&p->hwdec.av_device_ref, AV_HWDEVICE_TYPE_VAAPI,
+                              p->drm_node, NULL, 0) < 0) {
+        MP_WARN(ctx, "Matching adapter does not support VAAPI; software decoding remains available.\n");
+        return 0;
+    }
+    static const int formats[] = {IMGFMT_NV12, IMGFMT_P010, 0};
+    p->hwdec.driver_name = "vaapi";
+    p->hwdec.hw_imgfmt = IMGFMT_VAAPI;
+    p->hwdec.supported_formats = formats;
+    p->devices = devices;
+    hwdec_devices_add(devices, &p->hwdec);
+    return 0;
+}
