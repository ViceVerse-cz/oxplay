+bool pl_metal_offscreen_available(pl_gpu gpu)
+{
+    struct pl_gpu_metal *p = PL_PRIV(gpu);
+    void *opaque = p->offscreen_cmds[p->offscreen_slot];
+    if (!opaque)
+        return true;
+    id<MTLCommandBuffer> cmd = (__bridge id<MTLCommandBuffer>)opaque;
+    // Serialize the BUSY decision with its completion notification. Arming
+    // before an unlocked status query can spuriously wake a ready host; arming
+    // after it can miss completion. This tiny CPU lock never waits for the GPU.
+    os_unfair_lock_lock(&p->offscreen_lock);
+    MTLCommandBufferStatus status = cmd.status;
+    bool ready = status == MTLCommandBufferStatusCompleted ||
+                 status == MTLCommandBufferStatusError;
+    p->offscreen_waiting = !ready;
+    os_unfair_lock_unlock(&p->offscreen_lock);
+    return ready;
+}
+
+bool pl_metal_offscreen_submit(pl_gpu gpu, void (*wakeup)(void *), void *data)
+{
+    struct pl_gpu_metal *p = PL_PRIV(gpu);
+    if (!pl_metal_offscreen_available(gpu))
+        return false;
+    uint32_t slot = p->offscreen_slot;
+    if (p->offscreen_cmds[slot])
+        CFBridgingRelease(p->offscreen_cmds[slot]);
+    id<MTLCommandBuffer> cmd = metal_cmd_get(p);
+    if (!cmd)
+        return false;
+    p->offscreen_cmds[slot] = (void *)CFBridgingRetain(cmd);
+    if (wakeup) {
+        [cmd addCompletedHandler:^(id<MTLCommandBuffer> completed) {
+            (void)completed;
+            os_unfair_lock_lock(&p->offscreen_lock);
+            bool notify = p->offscreen_waiting;
+            p->offscreen_waiting = false;
+            os_unfair_lock_unlock(&p->offscreen_lock);
+            if (notify)
+                wakeup(data);
+        }];
+    }
+    metal_cmd_submit(p, false);
+    p->offscreen_slot = (slot + 1) % METAL_MAX_IN_FLIGHT;
+    return true;
+}
+
+void pl_metal_offscreen_finish(pl_gpu gpu)
+{
+    struct pl_gpu_metal *p = PL_PRIV(gpu);
+    // Teardown alone drains pending native work; steady-state never waits.
+    metal_cmd_submit(p, true);
+    for (int i = 0; i < METAL_MAX_IN_FLIGHT; i++) {
+        if (p->offscreen_cmds[i]) {
+            [(__bridge id<MTLCommandBuffer>)p->offscreen_cmds[i] waitUntilCompleted];
+            CFBridgingRelease(p->offscreen_cmds[i]);
+            p->offscreen_cmds[i] = NULL;
+        }
+    }
+}
+
+void pl_metal_hold(pl_gpu gpu, const void *object)
+{
+    if (!object)
+        return;
+    struct pl_gpu_metal *p = PL_PRIV(gpu);
+    CFTypeRef retained = CFRetain(object);
+    [metal_cmd_get(p) addCompletedHandler:^(id<MTLCommandBuffer> completed) {
+        (void)completed;
+        CFRelease(retained);
+    }];
+}
