@@ -0,0 +1,159 @@
+// SPDX-License-Identifier: LGPL-2.1-or-later
+// VideoToolbox import follows upstream hwdec_vt_pl.m, using native Metal wraps.
+#import <Metal/Metal.h>
+#import <CoreVideo/CoreVideo.h>
+#include <libavutil/hwcontext.h>
+#include "mpv_talloc.h"
+#include "common/msg.h"
+#include "libmpv_gpu_next.h"
+#include "libmpv_mtl_vt.h"
+#include "pl_utils.h"
+
+struct vt_mapping {
+    struct vt_mapping *next;
+    CVPixelBufferRef pixel;
+    CVMetalTextureRef planes[4];
+    pl_tex textures[4];
+};
+struct mpv_metal_vt {
+    pl_metal metal;
+    struct mp_hwdec_devices *devices;
+    struct mp_hwdec_ctx hw;
+    CVMetalTextureCacheRef cache;
+    struct vt_mapping *mapped;
+};
+
+struct mpv_metal_vt *mpv_metal_vt_create(struct libmpv_gpu_next_context *ctx,
+                                        pl_metal metal, struct mp_hwdec_devices *devices)
+{
+    struct mpv_metal_vt *vt = talloc_zero(NULL, struct mpv_metal_vt);
+    vt->metal = metal;
+    vt->devices = devices;
+    vt->hw.driver_name = "videotoolbox";
+    vt->hw.hw_imgfmt = IMGFMT_VIDEOTOOLBOX;
+    if (av_hwdevice_ctx_create(&vt->hw.av_device_ref,
+            AV_HWDEVICE_TYPE_VIDEOTOOLBOX, NULL, NULL, 0) < 0 ||
+        CVMetalTextureCacheCreate(kCFAllocatorDefault, NULL,
+            (__bridge id<MTLDevice>)metal->device, NULL, &vt->cache) != kCVReturnSuccess)
+    {
+        MP_ERR(ctx, "Could not initialize native VideoToolbox texture import.\n");
+        mpv_metal_vt_destroy(&vt);
+        return NULL;
+    }
+    hwdec_devices_add(devices, &vt->hw);
+    return vt;
+}
+
+static void free_mapping(struct mpv_metal_vt *vt, struct vt_mapping *mapping)
+{
+    for (int i = 0; i < 4; i++) {
+        pl_tex_destroy(vt->metal->gpu, &mapping->textures[i]);
+        if (mapping->planes[i])
+            CFRelease(mapping->planes[i]);
+    }
+    if (mapping->pixel)
+        CVPixelBufferRelease(mapping->pixel);
+    talloc_free(mapping);
+}
+
+void mpv_metal_vt_destroy(struct mpv_metal_vt **ptr)
+{
+    struct mpv_metal_vt *vt = *ptr;
+    if (!vt)
+        return;
+    // Native caller drains all submitted work before reaching this function.
+    while (vt->mapped) {
+        struct vt_mapping *m = vt->mapped;
+        vt->mapped = m->next;
+        free_mapping(vt, m);
+    }
+    hwdec_devices_remove(vt->devices, &vt->hw);
+    av_buffer_unref(&vt->hw.av_device_ref);
+    if (vt->cache)
+        CFRelease(vt->cache);
+    talloc_free(vt);
+    *ptr = NULL;
+}
+
+bool mpv_metal_vt_map(struct mpv_metal_vt *vt, struct pl_frame *frame, struct mp_image *image)
+{
+    struct pl_plane_data data[4] = {0};
+    int count = plane_data_from_imgfmt(data, &frame->repr.bits, image->params.hw_subfmt, false);
+    if (!count || count > 4 || !image->planes[3])
+        return false;
+    struct vt_mapping *m = talloc_zero(NULL, struct vt_mapping);
+    m->pixel = (CVPixelBufferRef)image->planes[3];
+    CVPixelBufferRetain(m->pixel);
+    bool planar = CVPixelBufferIsPlanar(m->pixel);
+    if ((planar && CVPixelBufferGetPlaneCount(m->pixel) != count) || (!planar && count != 1))
+        goto fail;
+    for (int i = 0; i < count; i++) {
+        int components = 0;
+        while (components < 4 && data[i].component_size[components])
+            components++;
+        MTLPixelFormat format;
+        int bits = data[i].component_size[0];
+        if (components == 1 && bits == 8) format = MTLPixelFormatR8Unorm;
+        else if (components == 2 && bits == 8) format = MTLPixelFormatRG8Unorm;
+        else if (components == 1 && bits == 16) format = MTLPixelFormatR16Unorm;
+        else if (components == 2 && bits == 16) format = MTLPixelFormatRG16Unorm;
+        else if (components == 4 && bits == 8) {
+            format = CVPixelBufferGetPixelFormatType(m->pixel) == kCVPixelFormatType_32BGRA
+                ? MTLPixelFormatBGRA8Unorm : MTLPixelFormatRGBA8Unorm;
+        } else goto fail;
+        size_t width = planar ? CVPixelBufferGetWidthOfPlane(m->pixel, i)
+                              : CVPixelBufferGetWidth(m->pixel);
+        size_t height = planar ? CVPixelBufferGetHeightOfPlane(m->pixel, i)
+                               : CVPixelBufferGetHeight(m->pixel);
+        if (CVMetalTextureCacheCreateTextureFromImage(kCFAllocatorDefault, vt->cache,
+                m->pixel, NULL, format, width, height, i, &m->planes[i]) != kCVReturnSuccess)
+            goto fail;
+        m->textures[i] = pl_metal_wrap(vt->metal->gpu, pl_metal_wrap_params(
+            .texture = (__bridge void *)CVMetalTextureGetTexture(m->planes[i])));
+        if (!m->textures[i] || !m->textures[i]->params.sampleable)
+            goto fail;
+        frame->planes[i] = (struct pl_plane){.texture = m->textures[i], .components = components};
+        for (int c = 0; c < components; c++)
+            frame->planes[i].component_mapping[c] = data[i].component_map[c];
+        // BGRA textures are sampled as RGBA by Metal, unlike raw memory order.
+        if (format == MTLPixelFormatBGRA8Unorm) {
+            frame->planes[i].component_mapping[0] = PL_CHANNEL_R;
+            frame->planes[i].component_mapping[1] = PL_CHANNEL_G;
+            frame->planes[i].component_mapping[2] = PL_CHANNEL_B;
+        }
+    }
+    frame->num_planes = count;
+    frame->user_data = m;
+    pl_frame_set_chroma_location(frame, image->params.chroma_location);
+    m->next = vt->mapped;
+    vt->mapped = m;
+    return true;
+fail:
+    free_mapping(vt, m);
+    return false;
+}
+
+void mpv_metal_vt_unmap(struct mpv_metal_vt *vt, struct pl_frame *frame)
+{
+    struct vt_mapping **link = &vt->mapped;
+    while (*link && *link != frame->user_data)
+        link = &(*link)->next;
+    if (!*link)
+        return;
+    struct vt_mapping *m = *link;
+    *link = m->next;
+    free_mapping(vt, m);
+}
+
+void mpv_metal_vt_hold(struct mpv_metal_vt *vt, struct pl_frame *frame)
+{
+    // Software frames have unrelated user_data; never dereference it here.
+    for (struct vt_mapping *m = vt->mapped; m; m = m->next) {
+        if (m != frame->user_data)
+            continue;
+        pl_metal_hold(vt->metal->gpu, m->pixel);
+        for (int i = 0; i < 4; i++)
+            pl_metal_hold(vt->metal->gpu, m->planes[i]);
+        break;
+    }
+}
