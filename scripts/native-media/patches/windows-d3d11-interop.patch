+#include <d3d11_4.h>
+#include <d3d10.h>
+#include "common/msg.h"
+#include "mpv/render_d3d11.h"
+#include "osdep/windows_utils.h"
+#include "ra_d3d11.h"
+#include "video/out/gpu/libmpv_gpu.h"
+#include "video/out/gpu/ra.h"
+
+/* ABI checked again in Rust; all supported desktop targets are 64-bit. */
+_Static_assert(sizeof(void *) == 8, "64-bit native media ABI");
+_Static_assert(sizeof(mpv_d3d11_init_params) == 8, "D3D11 init ABI");
+_Static_assert(sizeof(mpv_d3d11_fbo) == 56, "D3D11 target ABI");
+
+struct priv {
+    ID3D11Device *device;
+    ID3D11DeviceContext4 *context;
+    mpv_d3d11_fbo current;
+    bool failed;
+    struct ra_tex *wrapped_tex;
+    ID3D11Texture2D *wrapped_d3d_tex;
+};
+
+static int init(struct libmpv_gpu_context *ctx, mpv_render_param *params)
+{
+    struct priv *p = ctx->priv = talloc_zero(NULL, struct priv);
+
+    mpv_d3d11_init_params *init_params =
+        get_mpv_render_param(params, MPV_RENDER_PARAM_D3D11_INIT_PARAMS, NULL);
+    if (!init_params || !init_params->device)
+        return MPV_ERROR_INVALID_PARAMETER;
+
+    p->device = init_params->device;
+    ID3D11Device_AddRef(p->device);
+    if (ID3D11Device_GetCreationFlags(p->device) & D3D11_CREATE_DEVICE_SINGLETHREADED)
+        return MPV_ERROR_UNSUPPORTED;
+    ID3D11Device5 *device5 = NULL;
+    if (FAILED(ID3D11Device_QueryInterface(p->device, &IID_ID3D11Device5,
+                                         (void **)&device5)))
+        return MPV_ERROR_UNSUPPORTED;
+    ID3D11Device5_Release(device5);
+    ID3D11DeviceContext *immediate = NULL;
+    ID3D11Device_GetImmediateContext(p->device, &immediate);
+    HRESULT hr = ID3D11DeviceContext_QueryInterface(immediate,
+                       &IID_ID3D11DeviceContext4, (void **)&p->context);
+    ID3D11DeviceContext_Release(immediate);
+    if (FAILED(hr))
+        return MPV_ERROR_UNSUPPORTED;
+    ID3D10Multithread *multithread = NULL;
+    if (FAILED(ID3D11DeviceContext4_QueryInterface(p->context,
+                      &IID_ID3D10Multithread, (void **)&multithread)))
+        return MPV_ERROR_UNSUPPORTED;
+    BOOL protected = ID3D10Multithread_GetMultithreadProtected(multithread);
+    ID3D10Multithread_Release(multithread);
+    if (!protected)
+        return MPV_ERROR_UNSUPPORTED;
+
+    struct ra_ctx *ra_ctx = talloc_zero(p, struct ra_ctx);
+    ra_ctx->log = ctx->log;
+    ra_ctx->global = ctx->global;
+    ctx->ra_ctx = ra_ctx;
+
+    if (!spirv_compiler_init(ra_ctx))
+        return MPV_ERROR_UNSUPPORTED;
+
+    ra_ctx->ra = ra_d3d11_create(p->device, ctx->log, ra_ctx->spirv);
+    if (!ra_ctx->ra)
+        return MPV_ERROR_UNSUPPORTED;
+
+    ctx->ra_ctx = ra_ctx;
+    return 0;
+}
+
+static int validate_fbo(struct libmpv_gpu_context *ctx, mpv_render_param *params,
+                        mpv_d3d11_fbo **out)
+{
+    struct priv *p = ctx->priv;
+    mpv_d3d11_fbo *fbo =
+        get_mpv_render_param(params, MPV_RENDER_PARAM_D3D11_FBO, NULL);
+    if (!fbo || !fbo->result)
+        return MPV_ERROR_INVALID_PARAMETER;
+    *fbo->result = MPV_ERROR_INVALID_PARAMETER;
+    if (!fbo->tex || !fbo->signal_fence || !fbo->signal_value ||
+        fbo->w <= 0 || fbo->h <= 0)
+        return MPV_ERROR_INVALID_PARAMETER;
+    if (p->failed) {
+        *fbo->result = MPV_ERROR_GENERIC;
+        return MPV_ERROR_GENERIC;
+    }
+    D3D11_TEXTURE2D_DESC desc;
+    ID3D11Texture2D_GetDesc((ID3D11Texture2D *)fbo->tex, &desc);
+    ID3D11Device *device = NULL;
+    ID3D11Texture2D_GetDevice((ID3D11Texture2D *)fbo->tex, &device);
+    bool same_device = device == p->device;
+    ID3D11Device_Release(device);
+    if (!same_device || desc.Width != fbo->w || desc.Height != fbo->h ||
+        desc.Usage != D3D11_USAGE_DEFAULT || desc.ArraySize != 1 ||
+        desc.MipLevels != 1 || desc.SampleDesc.Count != 1 ||
+        !(desc.BindFlags & D3D11_BIND_RENDER_TARGET) ||
+        !(desc.BindFlags & D3D11_BIND_SHADER_RESOURCE) ||
+        !(desc.MiscFlags & D3D11_RESOURCE_MISC_SHARED_NTHANDLE) ||
+        !(desc.MiscFlags & D3D11_RESOURCE_MISC_SHARED) ||
+        (desc.MiscFlags & D3D11_RESOURCE_MISC_SHARED_KEYEDMUTEX) ||
+        desc.Format != DXGI_FORMAT_R8G8B8A8_UNORM)
+        return MPV_ERROR_INVALID_PARAMETER;
+    *out = fbo;
+    *fbo->result = 0;
+    return 0;
+}
+
+static int get_target_size(struct libmpv_gpu_context *ctx, mpv_render_param *params,
+                           int *out_w, int *out_h)
+{
+    mpv_d3d11_fbo *fbo;
+    int err = validate_fbo(ctx, params, &fbo);
+    if (err < 0)
+        return err;
+    *out_w = fbo->w;
+    *out_h = fbo->h;
+    return 0;
+}
+
+static int wrap_fbo(struct libmpv_gpu_context *ctx, mpv_render_param *params,
+                    struct ra_tex **out)
+{
+    struct priv *p = ctx->priv;
+    mpv_d3d11_fbo *fbo;
+    int err = validate_fbo(ctx, params, &fbo);
+    if (err < 0)
+        return err;
+    p->current = *fbo;
+    if (fbo->wait_fence && FAILED(ID3D11DeviceContext4_Wait(p->context,
+                       (ID3D11Fence *)fbo->wait_fence, fbo->wait_value))) {
+        p->failed = true;
+        return *fbo->result = MPV_ERROR_GENERIC;
+    }
+    p->wrapped_tex = ra_d3d11_wrap_tex(ctx->ra_ctx->ra,
+                                       (ID3D11Resource *)fbo->tex);
+    if (!p->wrapped_tex)
+        return *fbo->result = MPV_ERROR_UNSUPPORTED;
+    *out = p->wrapped_tex;
+    return 0;
+}
+
+static void done_frame(struct libmpv_gpu_context *ctx, bool ds)
+{
+    struct priv *p = ctx->priv;
+    HRESULT hr = ID3D11DeviceContext4_Signal(p->context,
+                (ID3D11Fence *)p->current.signal_fence, p->current.signal_value);
+    if (FAILED(hr)) {
+        p->failed = true;
+        *p->current.result = MPV_ERROR_GENERIC;
+    }
+    // Flush enqueues work; it does not wait for GPU completion.
+    ra_d3d11_flush(ctx->ra_ctx->ra);
+    ra_tex_free(ctx->ra_ctx->ra, &p->wrapped_tex);
+    p->wrapped_d3d_tex = NULL;
+    p->current = (mpv_d3d11_fbo){0};
+}
+
+static void destroy(struct libmpv_gpu_context *ctx)
+{
+    struct priv *p = ctx->priv;
+    if (!p)
+        return;
+
+    if (ctx->ra_ctx && ctx->ra_ctx->ra) {
+        ra_tex_free(ctx->ra_ctx->ra, &p->wrapped_tex);
+        // ra_d3d11 frees its own struct from inside its destroy callback.
+        ctx->ra_ctx->ra->fns->destroy(ctx->ra_ctx->ra);
+        ctx->ra_ctx->ra = NULL;
+    }
+    if (ctx->ra_ctx && ctx->ra_ctx->spirv && ctx->ra_ctx->spirv->fns->uninit)
+        ctx->ra_ctx->spirv->fns->uninit(ctx->ra_ctx);
+    SAFE_RELEASE(p->context);
+    SAFE_RELEASE(p->device);
+}
+
+const struct libmpv_gpu_context_fns libmpv_gpu_context_d3d11 = {
+    .api_name   = MPV_RENDER_API_TYPE_D3D11,
+    .init       = init,
+    .wrap_fbo   = wrap_fbo,
+    .get_target_size = get_target_size,
+    .done_frame = done_frame,
+    .destroy    = destroy,
+};
